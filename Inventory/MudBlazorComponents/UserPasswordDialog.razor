@using Inventory.Authentication
@inject UserAdmin Users

<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="password" Label="@($"New password (at least {PasswordService.MinimumLength} characters)")" InputType="InputType.Password"
                      Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" Immediate="true" />
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" id="user-dialog-error">@error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
        <MudButton id="user-save" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="busy" data-shortcut="save">Change password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int UserId { get; set; }

    private string? password;
    private string? error;
    private bool busy;

    private async Task Save()
    {
        busy = true;
        error = null;
        try
        {
            var result = await Users.ResetPasswordAsync(UserId, password);
            if (result.Ok)
            {
                MudDialog.Close(DialogResult.Ok(result.Message));
            }
            else
            {
                error = result.Message;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
