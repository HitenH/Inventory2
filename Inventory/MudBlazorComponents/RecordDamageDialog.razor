@* Stage 2, batch 2-3 (Hiten, 25-26 Nov 2026): "Record damage" on a purchase or a sales return. One pop-up listing every line,
   each with a "Damaged" box showing how many of its pieces are damaged now. Raise it to record more damage (with a reason),
   lower it when pieces turn out not to be damaged after all; save once for the whole entry. Saved as one stock change of the
   differences - nothing earlier is changed, so the history stays complete. Rules in Service/StockChangeService.cs.
   Enter moves down the "Damaged" column, Ctrl+S saves, Esc asks first when something was changed. *@
@using Inventory.Service

<MudDialog>
    <DialogContent>
        <div class="damage-entry" @onkeydown="OnKeyDownAsync">
            @if (candidates is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (candidates.Count == 0)
            {
                <p>This entry has no lines yet.</p>
            }
            else
            {
                <div class="d-flex flex-row flex-wrap gap-3 align-items-end mb-3">
                    <div>
                        <label class="form-label" for="damage-reason-all">Reason for all</label>
                        <select id="damage-reason-all" class="form-control" style="min-width:220px;" @bind="reasonForAll">
                            @foreach (var r in reasons)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <small class="text-muted mb-2">Type how many pieces of each line are damaged. Lower a number if they are not damaged after all. Enter moves down; Ctrl+S saves.</small>
                </div>

                <table class="table table-striped table-bordered table-sm mb-0 lines-table damage-table">
                    <thead>
                        <tr>
                            <th class="c-sl num">#</th>
                            <th class="c-pid">Product ID</th>
                            <th class="c-name">Product Name</th>
                            <th class="c-vid">Variant</th>
                            <th class="c-qty num">@ReceivedTitle</th>
                            <th class="c-dmg num">Damaged</th>
                            <th class="c-reason">Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < rows.Count; i++)
                        {
                            var row = rows[i];
                            var index = i;
                            var change = row.Change;
                            <tr class="damage-row @(change != 0 ? "damage-row-changed" : "")">
                                <td class="c-sl num">@row.Line.SerialNumber</td>
                                <td class="c-pid">@row.Line.ProductId</td>
                                <td class="c-name" title="@row.Line.ProductName">@row.Line.ProductName</td>
                                <td class="c-vid" title="@row.Line.VariantName">@row.Line.VariantId</td>
                                <td class="c-qty num">@row.Line.Received</td>
                                <td class="c-dmg num">
                                    <input id="@($"damage-qty-{index}")" type="number" min="@row.Line.Lowest" max="@row.Line.Received" step="1" class="form-control text-center damage-qty"
                                           @bind="row.Damaged" @bind:event="oninput" @onkeydown="e => OnQuantityKeyAsync(e, index)" autocomplete="off" onfocus="this.select()"
                                           title="@($"0 to {row.Line.Received}" + (row.Line.Lowest > 0 ? $" (at least {row.Line.Lowest}: already dealt with)" : ""))" />
                                    @if (change != 0)
                                    {
                                        <div class="damage-was">was @row.Line.Damaged</div>
                                    }
                                </td>
                                <td class="c-reason">
                                    @if (change < 0)
                                    {
                                        <span class="damage-not">@Inventory.Domain.StockReasons.NotDamaged</span>
                                    }
                                    else
                                    {
                                        <select class="form-control damage-reason" @bind="row.ReasonOverride">
                                            <option value="">@($"↑ {reasonForAll}")</option>
                                            @foreach (var r in reasons)
                                            {
                                                <option value="@r">@r</option>
                                            }
                                        </select>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <label class="form-label" for="damage-note">Note</label>
                    <input id="damage-note" type="text" class="form-control" @bind="note" autocomplete="off" />
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="me-auto ms-3 damage-count">@Summary</div>
        <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" OnClick="CancelAsync">Cancel</MudButton>
        <MudButton id="damage-save" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="saving"
                   StartIcon="@Icons.Material.Filled.Save" data-shortcut="save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DamageSource Source { get; set; }
    [Parameter] public Guid SourceId { get; set; }

    [Inject] private StockChangeService StockChanges { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ILogger<RecordDamageDialog> Logger { get; set; } = default!;

    private sealed class Row(DamageCandidate line)
    {
        public DamageCandidate Line { get; } = line;
        /// <summary>How many pieces are damaged now: starts at what is recorded.</summary>
        public int? Damaged { get; set; } = line.Damaged;
        /// <summary>Empty: the "Reason for all".</summary>
        public string ReasonOverride { get; set; } = "";
        /// <summary>Above 0: more damaged; below 0: not damaged after all.</summary>
        public int Change => (Damaged ?? Line.Damaged) - Line.Damaged;
    }

    private List<DamageCandidate>? candidates;
    private List<Row> rows = new();
    private List<string> reasons = new();
    private string reasonForAll = "";
    private string? note;
    private bool saving;
    private bool closing;
    private bool focused;

    private string ReceivedTitle => Source == DamageSource.Purchase ? "Received" : "Returned";
    private bool AnythingTyped => rows.Any(r => r.Change != 0) || !string.IsNullOrWhiteSpace(note);

    private string Summary
    {
        get
        {
            var more = rows.Where(r => r.Change > 0).Sum(r => r.Change);
            var back = -rows.Where(r => r.Change < 0).Sum(r => r.Change);
            if (more == 0 && back == 0)
            {
                return "No changes yet";
            }

            return string.Join(" · ", new[] { more > 0 ? $"{more} more damaged" : null, back > 0 ? $"{back} not damaged after all" : null }.Where(t => t is not null));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            reasons = await StockChanges.ReasonsAsync();
            reasonForAll = reasons.FirstOrDefault() ?? "";
            candidates = await StockChanges.DamageCandidatesAsync(Source, SourceId);
            rows = candidates.Select(c => new Row(c)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Record damage: loading the lines failed");
            Snackbar.Add("Could not load the lines of this entry.", Severity.Error);
            candidates = new();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (candidates is { Count: > 0 } && !focused)
        {
            focused = true;
            await JS.FocusBoxAsync("#damage-qty-0");
        }
    }

    /// <summary>Enter in a "Damaged" box moves to the next line, and from the last one to Note.</summary>
    private async Task OnQuantityKeyAsync(KeyboardEventArgs e, int index)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        await JS.FocusBoxAsync(index + 1 < rows.Count ? $"#damage-qty-{index + 1}" : "#damage-note");
    }

    private async Task SaveAsync()
    {
        if (saving || candidates is null)
        {
            return;
        }

        var entries = rows.Select(r => new DamageEntry(r.Line.LineId, r.Damaged ?? r.Line.Damaged,
            string.IsNullOrEmpty(r.ReasonOverride) ? reasonForAll : r.ReasonOverride)).ToList();
        var problem = StockChangeRules.DamageProblem(candidates, entries);
        if (problem is not null)
        {
            Snackbar.Add(problem, Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            var result = await StockChanges.RecordDamageAsync(Source, SourceId, entries, note);
            closing = true;
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (StockChangeRefused ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Record damage failed");
            Snackbar.Add("Could not record the damage. Nothing was saved. " + (DbErrors.RuleMessage(ex) ?? ""), Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (closing)
        {
            return;
        }

        if (AnythingTyped && !await DialogService.ConfirmAsync("Close without saving?", "The changes you typed have not been saved and will be lost.", "Close without saving", Color.Error, enterConfirms: true))
        {
            return;
        }

        closing = true;
        MudDialog.Cancel();
    }

    // Esc closes the pop-up (asking first when something was changed); MudBlazor's own Esc close is switched off below.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !e.CtrlKey && !e.AltKey && !e.ShiftKey)
        {
            await CancelAsync();
        }
    }

    /// <summary>Opens the pop-up. Returns what was saved, or null when nothing was.</summary>
    public static async Task<DamageResult?> ShowAsync(IDialogService dialogService, DamageSource source, Guid sourceId, string title)
    {
        var parameters = new DialogParameters<RecordDamageDialog>
        {
            { x => x.Source, source },
            { x => x.SourceId, sourceId },
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = false,
            BackdropClick = false,
            CloseButton = false,
            Position = DialogPosition.Center,
            DefaultFocus = DefaultFocus.None,
        };
        var dialog = await dialogService.ShowAsync<RecordDamageDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: DamageResult saved } ? saved : null;
    }
}
