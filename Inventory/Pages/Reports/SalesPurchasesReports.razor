@using Inventory.Domain.Repository.Abstract
@using MudBlazor

<MudStack Spacing="20">
    <MudSelect T="string" Label="Filter by Time" Value="selectedTimeFilter" ValueChanged="OnTimeFilterChanged">
        @foreach (var period in ReportPeriods.All)
        {
            <MudSelectItem Value="@period.Key">@period.Label</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.body2">@periodText</MudText>
    <MudGrid Spacing="10">
        <MudItem xs="6">

            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Total Sales</MudText>
                    <MudText Typo="Typo.h4">@totalSales.ToString()</MudText>
                </MudCardContent>
            </MudCard>

        </MudItem>
        <MudItem xs="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Total Purchases</MudText>
                    <MudText Typo="Typo.h4">@totalPurchases.ToString()</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudStack>

@code {

    [Inject] private ISaleRepository SaleRepository { get; set; }
    [Inject] private IPurchaseRepository PurchaseRepository { get; set; }
    [Inject] private ILogger<Sales> Logger { get; set; }
    [Inject] private NavigationManager navManager { get; set; }

    private string selectedTimeFilter = ReportPeriods.Today;
    private string periodText = "";

    private decimal totalSales;
    private decimal totalPurchases;


    protected override async Task OnInitializedAsync()
    {
        await LoadTotals();
    }

    // Batch 14: both totals are added up in the database for the chosen dates
    // (the screen used to load every sale and purchase and filter them here).
    private async Task LoadTotals()
    {
        var (from, to) = ReportPeriods.Range(selectedTimeFilter, DateOnly.FromDateTime(DateTime.Now));
        periodText = from == to ? $"{from:dd-MM-yyyy}" : $"{from:dd-MM-yyyy} to {to:dd-MM-yyyy}";

        try
        {
            totalSales = await SaleRepository.GetTotalBetweenAsync(from, to);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading total sales");
        }

        try
        {
            totalPurchases = await PurchaseRepository.GetTotalBetweenAsync(from, to);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading total purchases");
        }
    }

    private async Task OnTimeFilterChanged(string value)
    {
        selectedTimeFilter = value;
        await LoadTotals();
    }
}
