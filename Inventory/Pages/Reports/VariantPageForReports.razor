@using Inventory.Domain.Entities
@using Inventory.Domain.Repository.Abstract
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Stage 3, batch 3-3 (Hiten, 26 Nov 2026): the stock of all the places this person sees, or of one place. With all places
   shown, Stock In Hand is split into a column per place and a Total in bold; with one place, one column. *@
@if (places.Count > 1)
{
    <div class="field mt-2" style="width:220px;">
        <label for="variant-report-place" class="form-label"><h4>Place</h4></label>
        <select id="variant-report-place" class="form-control" value="@(placeFilter?.ToString() ?? "")" @onchange="OnPlaceAsync">
            <option value="">@(Access?.Places is null ? "All places" : "All my places")</option>
            @foreach (var p in places)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>
}
<MudTable Items="variants" Dense="true" Bordered="true" Striped="true" Class="mt-2">
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.VariantId)">
                Variant ID
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.Name)">
                Name
            </MudTableSortLabel>
        </MudTh>
        @if (Split)
        {
            @foreach (var p in places)
            {
                var place = p;
                <MudTh Class="num c-place-qty">
                    <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => QtyIn(x.Id, place))">@place.Name</MudTableSortLabel>
                </MudTh>
            }
            <MudTh Class="num c-place-total">
                <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => stockInHand.GetValueOrDefault(x.Id).Sellable)">Total</MudTableSortLabel>
            </MudTh>
        }
        else
        {
            <MudTh Class="num">
                <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => stockInHand.GetValueOrDefault(x.Id).Sellable)">
                    Stock In Hand
                </MudTableSortLabel>
            </MudTh>
        }
        <MudTh Class="num">
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.ReorderLevel)">
                Reorder Level
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.Image)">
                Image
            </MudTableSortLabel>
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.VariantId</MudTd>
        <MudTd>@context.Name</MudTd>
        @if (Split)
        {
            @foreach (var p in places)
            {
                <MudTd Class="num c-place-qty">@QtyIn(context.Id, p)</MudTd>
            }
            <MudTd Class="num c-place-total"><StockFigure Figures="@stockInHand.GetValueOrDefault(context.Id)" /></MudTd>
        }
        else
        {
            <MudTd Class="num"><StockFigure Figures="@stockInHand.GetValueOrDefault(context.Id)" /></MudTd>
        }
        <MudTd Class="num">@context.ReorderLevel</MudTd>
        <MudTd>
            @if (context.Image != null)
            {
                <MudImage Src="@GetImage(context.Image)"
                          Width="80"
                          Height="80"
                          Alt="@($"Photo of variant {context.VariantId}")"
                          @onclick="() => OpenImagePopup(context.Image)"
                          Elevation="25"
                          Class="rounded-lg ma-4" />
            }
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudTd Class="text-center">Not Found!</MudTd>
    </NoRecordsContent>
</MudTable> 
<MudText Typo="Typo.h6" Class="mt-4">
    @* Stage 2: the total works like the rows – sellable pieces, the breakdown on a click. *@
    Total Stock In Hand:
    @if (Split)
    {
        @foreach (var p in places)
        {
            <span class="variant-total-place">@p.Name @variants.Sum(v => QtyIn(v.Id, p))</span>
        }
        <span class="variant-total-place">Total</span>
    }
    <StockFigure Figures="@totalStock" />
</MudText>
@code{

    [Parameter] public ProductEntity Product { get; set; }
    [Inject] private IVariantRepository VariantRepository { get; set; }
    [Inject] private IProductRepository ProductRepository { get; set; }
    [Inject] private IImageRepository ImageRepository { get; set; }
    [Inject] private IConfiguration config { get; set; }
    [Inject] private PlaceService PlaceService { get; set; } = default!;
    [CascadingParameter] private UserAccess? Access { get; set; }

    private List<VariantModel> variants = new();
    // Stage 2: sellable, damaged and waiting pieces per variant (shown by StockFigure).
    private Dictionary<Guid, Inventory.Domain.StockFigures> stockInHand = new();
    private Inventory.Domain.StockFigures totalStock;
    // Stage 3, batch 3-3: the places this person sees, the one chosen in the Place filter (null = all of them), pieces per place.
    private List<PlaceItem> places = new();
    private int? placeFilter;
    private Dictionary<Guid, List<Inventory.Domain.PlaceStock>> placeStock = new();

    /// <summary>All places shown (no place chosen) and more than one of them: a column per place and a Total.</summary>
    private bool Split => placeFilter is null && places.Count > 1;

    /// <summary>The sellable pieces of a variant in one place.</summary>
    private int QtyIn(Guid variantId, PlaceItem place) =>
        (placeStock.GetValueOrDefault(variantId) ?? []).FirstOrDefault(s => s.Name == place.Name).Qty;

    protected override async Task OnParametersSetAsync()
    {
        places = (await PlaceService.AllAsync()).Where(p => Access?.SeesPlace(p.Id) != false).ToList();
        GetVariants();
        await LoadStockInHandAsync();
        CalculateTotalStockInHand();
    }

    
    //Open Image Popup
    private async Task OpenImagePopup(Image image)
    {
        var parameters = new DialogParameters();
        parameters.Add("ImageHere", image);
        var dialog = await DialogService.ShowAsync<ImagePopup>(image.ImageTitle, parameters);
        var result = await dialog.Result;
    }

    public void GetVariants()
    {
        if (Product?.Variants is { Count: > 0 })
        {
            variants = Product.Variants.Select(v => v.ToModel()).ToList();
        }
        else
        {
            variants = new List<VariantModel>();
        }
    }

    public string GetImage(Image image) => Photos.UrlFor(image);   // batch 14: a normal image address, not packed into the page

    private async Task LoadStockInHandAsync()
    {
        if (Product?.Variants is not { Count: > 0 })
        {
            stockInHand = new Dictionary<Guid, Inventory.Domain.StockFigures>();
            placeStock = new Dictionary<Guid, List<Inventory.Domain.PlaceStock>>();
            return;
        }

        var shown = placeFilter is { } one ? new HashSet<int> { one } : Access?.Places;
        var ids = Product.Variants.Select(v => v.Id).ToList();
        stockInHand = await ProductRepository.GetStockByVariantIdsAsync(ids, shown);
        placeStock = await ProductRepository.GetPlaceStockAsync(ids, shown);
    }

    private async Task OnPlaceAsync(ChangeEventArgs e)
    {
        placeFilter = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadStockInHandAsync();
        CalculateTotalStockInHand();
    }

    private void CalculateTotalStockInHand()
    {
        totalStock = new Inventory.Domain.StockFigures(
            stockInHand.Values.Sum(s => s.Sellable), stockInHand.Values.Sum(s => s.Damaged), stockInHand.Values.Sum(s => s.Waiting));
    }
}