@page "/purchase/{purchaseId?}";
@using Inventory.Shared.Selectors

@* Cursor: Supplier on a new purchase; once it is saved (or when an existing one is opened), the product box of the line. *@
<FocusOnOpen Selector="@(PurchaseId == null ? ".focus-supplier" : ".focus-line-product")" />


<EditForm Model="@purchaseModel" class="card-header mt-2 head-card"
          OnValidSubmit="async ()=>
                {
                    if(PurchaseId == null){
                        await AddPurchase();
                }
                    else{
                        await EditPurchase();
                } }">


    <DataAnnotationsValidator />

    @* Batch 17 round 3: supplier, voucher, date and the buttons on one row (owner: the top was too big).
       Remarks moved to the bar under the lines. *@
    <div class="head-row">
        <div class="field field-wide">
            <label for="voucher" class="form-label"><h4>Supplier</h4></label>
            <SupplierAutocomplete T="SupplierModel" Class="focus-supplier" EnterPressed="OnSupplierEnter" SelectedSupplier="selectedSupplier" SelectedSupplierChanged="OnSupplierSelected"/>

            <InputText @bind-Value="purchaseModel.SupplierId" class="form-control text-center" disabled hidden />
            <InputText @bind-Value="purchaseModel.SupplierName" class="form-control text-center ms-2" disabled hidden />
        </div>
        <div class="field field-voucher">
            <label for="voucher" class="form-label"><h4>Voucher</h4></label>
            @if (IsDisabled)
            {
                <InputNumber @bind-Value="purchaseModel.VoucherId" id="voucher" class="form-control text-center" disabled />
            }
            else
            {
                <InputNumber @bind-Value="purchaseModel.VoucherId" id="voucher" class="form-control text-center" />
            }
            
        </div>
        <div class="field field-date">
            <label for="date" class="form-label"><h4>Date</h4></label>
            <DateBox TValue="DateOnly" @bind-Value="purchaseModel.Date" Style="width:168px;" OpenLeft="true" />
        </div>
        <div class="head-actions">
            @if (PurchaseId == null)
            {
                <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-success">Save</button>
            }
            else
            {
                <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-warning">Update</button>
            }
            <NavLink type="button" href="/purchases" id="button-close" class="btn btn-info">Close</NavLink>
            @if (PurchaseId != null)
            {
                <button type="button" class="btn btn-danger" @onclick="DeletePurchase">Delete</button>
            }
            <NavLink class="btn btn-secondary" href="/">Home</NavLink>
        </div>
    </div>
    <ValidationSummary />
</EditForm>


@if (PurchaseId != null)
{
    <PurchaseVariantComponent @ref="purchaseLines" Purchase="purchaseEntity" ChangeState="ChangeStatePurchaseVariant" />

    @* Batch 17: one compact totals bar, styled like the supplier card; Bulk Entry moved here from the line row. *@
    <EditForm Model="@PurchaseTotalData" Context="PurchaseTotalDataForm" class="card-header mt-3"
          OnValidSubmit="AddTotalAmount">
        <div class="totals-bar">
            <div class="totals-actions">
                <MudButton id="bulk-entry-open" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="() => purchaseLines!.OpenBulkEntryAsync()" data-shortcut="bulk" title="Alt+B">Bulk Entry</MudButton>
                <button type="submit" id="button-submit" class="btn btn-success" @onclick="AddTotalAmount">Save Total Amount</button>
            </div>
            @* Batch 17 round 3: Remarks/Narration moved here from the top card; saved by Update and by Save Total Amount. *@
            <div class="field totals-remarks">
                <label for="Remarks" class="form-label">Remarks / Narration</label>
                <InputText @bind-Value="purchaseModel.Remarks" id="Remarks" class="form-control text-start" />
            </div>
            <div class="field totals-field">
                <label for="totalquantity" class="form-label">Total Quantity</label>
                <InputNumber @bind-Value="PurchaseTotalData.TotalQuantity" id="totalquantity" class="form-control text-center" disabled />
            </div>
            <div class="field totals-field">
                <label for="discount" class="form-label">Discount</label>
                <MudNumericField T="decimal" Value="PurchaseTotalData.Discount" ValueChanged="(value)=>DiscountChanged(value)" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="box-center" />
            </div>
            <div class="field totals-field">
                <label for="totalamount" class="form-label">Total Amount</label>
                <InputNumber @bind-Value="PurchaseTotalData.TotalAmount" id="totalamount" class="form-control text-center" disabled />
            </div>
        </div>
    </EditForm>
}