@page "/salesorder/{salesorderId?}";
@using Inventory.Shared.Selectors

@* Cursor: Customer on a new sales order; once it is saved (or when an existing one is opened), the product box of the line. *@
<FocusOnOpen Selector="@(SalesOrderId == null ? ".focus-customer" : ".focus-line-product")" />

<EditForm Model="@salesOrderModel" class="card-header mt-5"
          OnValidSubmit="async ()=>
                {
                    if(SalesOrderId == null){
                        await AddOrder();
                }
                    else{
                        await EditOrder();
                } }">
    <DataAnnotationsValidator />


    <div class="d-flex justify-content-between">
        <div style="min-width:350px;">
            <label class="form-label d-block text-center"><h4>Customer</h4></label>

            <CustomerAutocomplete T="CustomerModel" Class="focus-customer" EnterPressed="OnCustomerEnter"
                                  SelectedCustomer="customerModel"
                                  SelectedCustomerChanged="OnCustomerSelected" />

            <InputText @bind-Value="salesOrderModel.CustomerId" class="form-control text-center" disabled hidden />
            <InputText @bind-Value="salesOrderModel.CustomerName" class="form-control text-center ms-2" disabled hidden />
        </div>
        <div class="text-center">
            <label for="voucher" class="form-label"><h4>Voucher</h4></label>
            @if (IsDisabled)
            {
                <InputNumber @bind-Value="salesOrderModel.VoucherId" id="voucher" class="form-control text-center" disabled />
            }
            else
            {
                <InputNumber @bind-Value="salesOrderModel.VoucherId" id="voucher" class="form-control text-center" />
            }
        </div>
        <div class="text-center">
            <label for="orderstatus" class="form-label text-center"><h4>OrderStatus</h4></label>
            <InputSelect @bind-Value="salesOrderModel.OrderStatus" class="form-control text-center" id="orderstatus">
                <option value="@OrderStatus.None" class="text-center">None</option>
                <option value="@OrderStatus.Open" class="text-center">Open</option>
                <option value="@OrderStatus.Completed" class="text-center">Completed</option>
                <option value="@OrderStatus.Partly" class="text-center">Partly</option>
            </InputSelect>
        </div>
        <div class="text-center">
            <label for="date" class="form-label"><h4>Date</h4></label>
            <DateBox TValue="DateOnly" @bind-Value="salesOrderModel.Date" Style="width:170px;" OpenLeft="true" />
        </div>
        <div class="text-center">
            <label for="duedate" class="form-label"><h4>DueDate</h4></label>
            <DateBox TValue="DateOnly" @bind-Value="salesOrderModel.DueDate" Style="width:170px;" OpenLeft="true" />
        </div>
    </div>
    <ValidationSummary />
    <div class="mt-3">
        @if (SalesOrderId == null)
        {
            <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-success">Save</button>
        }
        else
        {
            <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-warning">Update</button>
        }
        <NavLink type="button" href="/salesorders" id="button-close" class="btn btn-info ms-2">Close</NavLink>
        @if (SalesOrderId != null)
        {
            <button type="button" class="btn btn-danger ms-3" @onclick="DeleteOrder">Delete</button>
        }
        <NavLink class="btn btn-secondary ms-3" href="/">Home</NavLink>
    </div>
</EditForm>


@if (SalesOrderId != null)
{
    <SalesOrderVariantComponent @ref="salesOrderLines" SalesOrder="salesOrderEntity" ChangeState="ChangeStateSalesOrderVariant" />

    @* Batch 17: one compact totals bar, styled like the customer card; Bulk Entry moved here from the line row. *@
    <EditForm Model="@SalesOrderTotalData" Context="SalesOrderTotalDataForm" class="card-header mt-3"
          OnValidSubmit="AddTotalAmount">
        <div class="totals-bar">
            <div class="totals-actions">
                <MudButton id="bulk-entry-open" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="() => salesOrderLines!.OpenBulkEntryAsync()" data-shortcut="bulk" title="Alt+B">Bulk Entry</MudButton>
                <button type="submit" id="button-submit" class="btn btn-success" @onclick="AddTotalAmount">Save Total Amount</button>
            </div>
            <div class="field totals-field">
                <label for="totalquantity" class="form-label">Total Quantity</label>
                <InputNumber @bind-Value="SalesOrderTotalData.TotalQuantity" id="totalquantity" class="form-control text-center" disabled />
            </div>
            <div class="field totals-field">
                <label for="discount" class="form-label">Discount</label>
                <MudNumericField T="decimal" Value="SalesOrderTotalData.Discount" ValueChanged="(value)=>DiscountChanged(value)" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="box-center" />
            </div>
            <div class="field totals-field">
                <label for="totalamount" class="form-label">Total Amount</label>
                <InputNumber @bind-Value="SalesOrderTotalData.TotalAmount" id="totalamount" class="form-control text-center" disabled />
            </div>
        </div>
    </EditForm>
}