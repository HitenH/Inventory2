@page "/damage"
@* Stage 2, batch 2-5 (Hiten, 25-26 Nov 2026): the damage report - everything lying in damage, one row per purchase line or
   returned line. Each row's Supplier and Status can be changed in the row itself (saved at once); or tick rows, then:
   Assign supplier, Ready to send, Repaired (back to sellable), Written off, or Sent, which makes one Purchase Return for the
   supplier. The Qty box takes fewer pieces than the whole row. "See activity log" in the bottom bar, as on every screen.
   Rules in Service/DamagedGoodsService.cs. *@

<div class="damage-report">
    <div class="d-flex flex-row flex-wrap gap-3 align-items-end mb-2">
        <MudText Typo="Typo.h5" Class="me-4">Damage report</MudText>
        <div>
            <label class="form-label" for="damage-show">Show</label>
            <select id="damage-show" class="form-control" style="min-width:190px;" @bind="show">
                <option value="all">Everything in damage</option>
                <option value="nosupplier">No supplier yet</option>
                <option value="assigned">Assigned</option>
                <option value="ready">Ready to send</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="damage-supplier">Supplier</label>
            <select id="damage-supplier" class="form-control" style="min-width:220px;" @bind="supplierFilter">
                <option value="">Any</option>
                @foreach (var s in lots.Where(l => l.SupplierId is not null).GroupBy(l => l.SupplierId).Select(g => g.First()).OrderBy(l => l.SupplierName))
                {
                    <option value="@s.SupplierId">@s.SupplierName</option>
                }
            </select>
        </div>
        <div class="flex-grow-1" style="min-width:220px;">
            <label class="form-label" for="damage-search">Search</label>
            <input id="damage-search" class="form-control" @bind="search" @bind:event="oninput" placeholder="Product, variant, from, reason" autocomplete="off" />
        </div>
    </div>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <table class="table table-striped table-bordered table-sm lines-table damage-report-table">
            <thead>
                <tr>
                    <th class="c-tick"><input type="checkbox" title="Tick all shown" checked="@AllTicked" @onchange="TickAll" /></th>
                    <th class="c-pid">Product ID</th>
                    <th class="c-name">Product Name</th>
                    <th class="c-vid">Variant</th>
                    <th class="c-qty num">Damaged</th>
                    <th class="c-dmg num">Qty</th>
                    <th class="c-from">From</th>
                    <th class="c-reason">Reason</th>
                    <th class="c-supplier">Supplier</th>
                    <th class="c-status">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Shown.Count == 0)
                {
                    <tr><td colspan="10" class="text-center">@(lots.Count == 0 ? "Nothing is lying in damage." : "Nothing matches.")</td></tr>
                }
                @foreach (var lot in Shown)
                {
                    var key = lot.Key;
                    <tr class="damage-lot @(ticked.Contains(key) ? "damage-lot-ticked" : "")">
                        <td class="c-tick"><input type="checkbox" class="damage-tick" checked="@ticked.Contains(key)" @onchange="e => Tick(key, (bool)e.Value!)" /></td>
                        <td class="c-pid">@lot.ProductId</td>
                        <td class="c-name" title="@lot.ProductName">@lot.ProductName</td>
                        <td class="c-vid" title="@lot.VariantName">@lot.VariantId</td>
                        <td class="c-qty num">@lot.Pieces</td>
                        <td class="c-dmg num">
                            <input type="number" class="form-control text-center damage-take" min="1" max="@lot.Pieces" step="1" autocomplete="off"
                                   value="@Take(lot)" @onchange="e => SetTake(lot, e.Value?.ToString())" title="@($"How many of the {lot.Pieces} to take (all by default)")" />
                        </td>
                        <td class="c-from" title="@($"{lot.From} – damaged on {lot.Since:dd-MM-yyyy}")">
                            @if (lot.FromLink is not null)
                            {
                                <a href="@lot.FromLink">@lot.From</a>
                            }
                            else
                            {
                                @lot.From
                            }
                        </td>
                        <td class="c-reason" title="@lot.Reasons">@lot.Reasons</td>
                        <td class="c-supplier" title="@lot.SupplierName">
                            <select class="form-select form-select-sm damage-row-supplier" value="@(lot.SupplierId?.ToString() ?? "")" @onchange="e => RowSupplierAsync(lot, e.Value?.ToString())">
                                @if (lot.SupplierId is null)
                                {
                                    <option value="">– choose –</option>
                                }
                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </td>
                        <td class="c-status">
                            @* Hiten, 26 Nov 2026: Repaired and Written off in the row's Status too (the row's Qty, after a confirmation).
                               The key changes when a confirmation is cancelled, so the drop-down shows the row's real status again. *@
                            <select @key="@($"{lot.Key}-{statusVersion}")" class="form-select form-select-sm damage-row-status damage-status-@StatusClass(lot)"
                                    value="@StatusValue(lot)" @onchange="e => RowStatusAsync(lot, e.Value?.ToString())">
                                @if (lot.SupplierId is null)
                                {
                                    <option value="none">No supplier yet</option>
                                }
                                else
                                {
                                    <option value="assigned">Assigned</option>
                                    <option value="ready">Ready to send</option>
                                }
                                <option value="repaired">Repaired</option>
                                <option value="writeoff">Written off</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="damage-actions">
            <div class="me-auto damage-ticked-count">@TickedText</div>
            <MudButton id="damage-assign" Variant="MudBlazor.Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="AssignSupplierAsync">Assign supplier</MudButton>
            <MudButton id="damage-ready" Variant="MudBlazor.Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="SetReadyAsync">Ready to send</MudButton>
            <MudButton id="damage-repaired" Variant="MudBlazor.Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="RepairAsync">Repaired</MudButton>
            <MudButton id="damage-writeoff" Variant="MudBlazor.Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="WriteOffAsync">Written off</MudButton>
            <MudButton id="damage-sent" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SendAsync"
                       StartIcon="@Icons.Material.Filled.LocalShipping">Sent → Purchase return</MudButton>
            <ActivityLogButton RecordType="@nameof(Inventory.Domain.Entities.StockChangeEntity)" RecordId="@ActivityLogService.DamageReportId" Title="Damage report" />
        </div>
    }
</div>

@code {
    [Inject] private DamagedGoodsService DamagedGoods { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ILogger<DamageReport> Logger { get; set; } = default!;

    private List<DamagedLot> lots = new();
    private List<(Guid Id, string Name)> suppliers = new();
    private readonly HashSet<Guid> ticked = new();
    private readonly Dictionary<Guid, int> takes = new();
    private bool loading = true;
    private string show = "all";
    private string supplierFilter = "";
    private string? search;

    private List<DamagedLot> Shown => lots.Where(l =>
            show switch
            {
                "nosupplier" => l.SupplierId is null,
                "assigned" => l.SupplierId is not null && !l.ReadyToSend,
                "ready" => l.ReadyToSend,
                _ => true,
            }
            && (supplierFilter == "" || l.SupplierId?.ToString() == supplierFilter)
            && (string.IsNullOrWhiteSpace(search) || $"{l.ProductId} {l.ProductName} {l.VariantId} {l.VariantName} {l.From} {l.Reasons} {l.SupplierName}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private List<DamagedLot> Ticked => lots.Where(l => ticked.Contains(l.Key)).ToList();
    private bool AllTicked => Shown.Count > 0 && Shown.All(l => ticked.Contains(l.Key));
    private int Take(DamagedLot lot) => takes.TryGetValue(lot.Key, out var n) ? n : lot.Pieces;

    private string TickedText
    {
        get
        {
            var rows = Ticked;
            return rows.Count == 0 ? "Tick the rows to act on." : $"{rows.Count} row{(rows.Count == 1 ? "" : "s")} ticked, {rows.Sum(Take)} piece{(rows.Sum(Take) == 1 ? "" : "s")}";
        }
    }

    private static string StatusClass(DamagedLot lot) => lot.ReadyToSend ? "ready" : lot.SupplierId is null ? "none" : "assigned";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            lots = await DamagedGoods.LotsAsync();
            suppliers = await DamagedGoods.SuppliersAsync();
            ticked.IntersectWith(lots.Select(l => l.Key));
            foreach (var key in takes.Keys.Except(lots.Select(l => l.Key)).ToList())
            {
                takes.Remove(key);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Damage report failed");
            Snackbar.Add("Could not load the damage report.", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void Tick(Guid key, bool on)
    {
        if (on)
        {
            ticked.Add(key);
        }
        else
        {
            ticked.Remove(key);
        }
    }

    private void TickAll(ChangeEventArgs e)
    {
        var on = e.Value is true;
        foreach (var lot in Shown)
        {
            Tick(lot.Key, on);
        }
    }

    private void SetTake(DamagedLot lot, string? text)
    {
        if (int.TryParse(text, out var n))
        {
            takes[lot.Key] = n;
        }
        else
        {
            takes.Remove(lot.Key);
        }
    }

    private bool NothingTicked()
    {
        if (ticked.Count > 0)
        {
            return false;
        }

        Snackbar.Add("Tick the rows first.", Severity.Warning);
        return true;
    }

    private async Task RunAsync(Func<Task<string>> action)
    {
        try
        {
            var done = await action();
            Snackbar.Add(done, Severity.Success);
            ticked.Clear();
            takes.Clear();
        }
        catch (StockChangeRefused ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Damage report action failed");
            Snackbar.Add("Could not save. Nothing was changed. " + (DbErrors.RuleMessage(ex) ?? ""), Severity.Error);
        }

        await ReloadAsync();
    }

    private async Task AssignSupplierAsync()
    {
        if (NothingTicked())
        {
            return;
        }

        var supplier = await PickSupplierDialog.ShowAsync(DialogService, "Assign supplier");
        if (supplier is null)
        {
            return;
        }

        var keys = ticked.ToList();
        await RunAsync(async () =>
        {
            await DamagedGoods.AssignSupplierAsync(keys, supplier.Id);
            return $"Supplier {supplier.Name} assigned to {keys.Count} row{(keys.Count == 1 ? "" : "s")}.";
        });
    }

    private async Task SetReadyAsync()
    {
        if (NothingTicked())
        {
            return;
        }

        var keys = ticked.ToList();
        await RunAsync(async () =>
        {
            await DamagedGoods.SetReadyAsync(keys, true);
            return "Marked ready to send.";
        });
    }

    /// <summary>Hiten, 26 Nov 2026: the Supplier drop-down of one row, saved at once (ticked rows stay ticked).</summary>
    private async Task RowSupplierAsync(DamagedLot lot, string? value)
    {
        if (!Guid.TryParse(value, out var supplierId) || supplierId == lot.SupplierId)
        {
            return;
        }

        await RowAsync(() => DamagedGoods.AssignSupplierAsync([lot.Key], supplierId),
            $"Supplier {suppliers.FirstOrDefault(s => s.Id == supplierId).Name} assigned.");
    }

    private int statusVersion;

    private static string StatusValue(DamagedLot lot) => lot.SupplierId is null ? "none" : lot.ReadyToSend ? "ready" : "assigned";

    /// <summary>
    /// The Status drop-down of one row: "Assigned" or "Ready to send" are saved at once; "Repaired" and "Written off" take the
    /// row's Qty out of damage after a confirmation (Hiten, 26 Nov 2026), like the buttons do for ticked rows.
    /// </summary>
    private async Task RowStatusAsync(DamagedLot lot, string? value)
    {
        if (value is "repaired" or "writeoff")
        {
            var repaired = value == "repaired";
            var pieces = Take(lot);
            var what = repaired ? "go back into sellable stock" : "leave stock for good (thrown away or lost)";
            if (!await DialogService.ConfirmAsync(repaired ? "Repaired?" : "Write off?",
                    $"{pieces} damaged piece{(pieces == 1 ? "" : "s")} of {lot.ProductId} / {lot.VariantId} will {what}.",
                    repaired ? "Repaired" : "Write off", repaired ? Color.Primary : Color.Error, enterConfirms: true))
            {
                statusVersion++;   // show the row's real status again
                return;
            }

            var lots = new List<LotPieces> { new(lot.Key, pieces) };
            await RowAsync(() => repaired ? DamagedGoods.RepairAsync(lots) : DamagedGoods.WriteOffAsync(lots),
                repaired ? $"Repaired: {pieces} back in stock." : $"Written off: {pieces}.");
            statusVersion++;
            return;
        }

        var ready = value == "ready";
        if (value == "none" || ready == lot.ReadyToSend)
        {
            return;
        }

        await RowAsync(() => DamagedGoods.SetReadyAsync([lot.Key], ready), ready ? "Marked ready to send." : "Back to assigned.");
    }

    private async Task RowAsync(Func<Task> save, string done)
    {
        try
        {
            await save();
            Snackbar.Add(done, Severity.Success);
        }
        catch (StockChangeRefused ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Damage report row change failed");
            Snackbar.Add("Could not save. Nothing was changed. " + (DbErrors.RuleMessage(ex) ?? ""), Severity.Error);
        }

        await ReloadAsync();
    }

    private List<LotPieces> TickedPieces() => Ticked.Select(l => new LotPieces(l.Key, Take(l))).ToList();

    private async Task RepairAsync()
    {
        if (NothingTicked() || !await Confirm("Repaired?", "go back into sellable stock", "Repaired", Color.Primary))
        {
            return;
        }

        var chosen = TickedPieces();
        await RunAsync(async () =>
        {
            await DamagedGoods.RepairAsync(chosen);
            return $"Repaired: {chosen.Sum(l => l.Pieces)} back in stock.";
        });
    }

    private async Task WriteOffAsync()
    {
        if (NothingTicked() || !await Confirm("Write off?", "leave stock for good (thrown away or lost)", "Write off", Color.Error))
        {
            return;
        }

        var chosen = TickedPieces();
        await RunAsync(async () =>
        {
            await DamagedGoods.WriteOffAsync(chosen);
            return $"Written off: {chosen.Sum(l => l.Pieces)}.";
        });
    }

    private async Task SendAsync()
    {
        if (NothingTicked())
        {
            return;
        }

        var supplier = Ticked.Select(l => l.SupplierName).Distinct().Count() == 1 ? Ticked[0].SupplierName : null;
        if (!await Confirm("Sent to the supplier?", $"go back to {supplier ?? "the supplier"} on a new purchase return", "Make purchase return", Color.Primary))
        {
            return;
        }

        var chosen = TickedPieces();
        await RunAsync(async () =>
        {
            var made = await DamagedGoods.SendBackAsync(chosen);
            return $"Purchase return {made.VoucherId} of {made.Date:dd-MM-yyyy} made: {chosen.Sum(l => l.Pieces)} pieces to {supplier}. It is on the Purchase Returns screen.";
        });
    }

    private Task<bool> Confirm(string title, string what, string button, Color color)
    {
        var pieces = Ticked.Sum(Take);
        return DialogService.ConfirmAsync(title, $"{pieces} damaged piece{(pieces == 1 ? "" : "s")} will {what}.", button, color, enterConfirms: true);
    }
}
