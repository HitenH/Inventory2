@page "/changepassword"
@using Inventory.Authentication
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Change Password</PageTitle>

<div class="d-flex justify-content-center">
    <EditForm Model="model" class="card-header" OnValidSubmit="Submit" style="min-width: 360px;">
        <DataAnnotationsValidator />
        <h4 class="mb-3">Change password for @userName</h4>

        <div class="mb-3">
            <label for="current-password" class="form-label">Current password</label>
            <InputText type="password" @bind-Value="model.CurrentPassword" id="current-password" class="form-control" autocomplete="current-password" />
            <ValidationMessage For="@(() => model.CurrentPassword)" />
        </div>
        <div class="mb-3">
            <label for="new-password" class="form-label">New password (at least @PasswordService.MinimumLength characters)</label>
            <InputText type="password" @bind-Value="model.NewPassword" id="new-password" class="form-control" autocomplete="new-password" />
            <ValidationMessage For="@(() => model.NewPassword)" />
        </div>
        <div class="mb-3">
            <label for="confirm-password" class="form-label">Repeat new password</label>
            <InputText type="password" @bind-Value="model.ConfirmPassword" id="confirm-password" class="form-control" autocomplete="new-password" />
            <ValidationMessage For="@(() => model.ConfirmPassword)" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2" role="alert">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success py-2" role="alert">@successMessage</div>
        }

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success" disabled="@isBusy">Change password</button>
            <a class="btn btn-secondary" href="/">Close</a>
        </div>
    </EditForm>
</div>
