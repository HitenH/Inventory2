@page "/settings"
@using Inventory.Service
@using Inventory.MudBlazorComponents
@inject BackupService backupService
@inject ISnackbar snackbar
@inject IDialogService DialogService
@inject Microsoft.JSInterop.IJSRuntime JS

<PagesHeader Title="Settings" SubTitle="Reports, backups, overview" />

<MudContainer>
    @if (backupService.RestartRequired)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            A backup has been restored. Close the Inventory app completely and start it again before doing any more work.
        </MudAlert>
    }

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Appearance</MudText>
        <MudText Typo="Typo.subtitle2">Colour</MudText>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var colour in AppTheme.Colours)
            {
                var chosen = colour == (Theme?.Colour ?? "Teal");
                <MudButton Variant="MudBlazor.Variant.Filled" OnClick="() => PickColour(colour)"
                           Style="@($"background:{AppTheme.LightHex(colour)};color:#fff;min-width:92px;" + (chosen ? "outline:2px solid var(--mud-palette-text-primary);outline-offset:2px;" : ""))">
                    @colour
                </MudButton>
            }
        </div>
        <MudText Typo="Typo.subtitle2">Mode</MudText>
        <MudRadioGroup T="string" Value="@(Theme?.Mode ?? "System")" ValueChanged="PickMode">
            <MudRadio T="string" Value="@("Light")">Light</MudRadio>
            <MudRadio T="string" Value="@("Dark")">Dark</MudRadio>
            <MudRadio T="string" Value="@("System")">Same as Windows</MudRadio>
        </MudRadioGroup>
        <MudText Typo="Typo.caption">Applies at once. Remembered on this computer.</MudText>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2"><b>Database:</b> @backupService.DatabasePath</MudText>
        <MudText Typo="Typo.body2"><b>Backup folder:</b> @backupService.BackupFolder</MudText>
        <MudText Typo="Typo.body2">
            <b>Last backup:</b>
            @(lastBackup is null ? "none yet" : lastBackup.Value.ToString("dd MMM yyyy HH:mm"))
        </MudText>
        <MudText Typo="Typo.caption">An automatic backup is made every day (when the app starts, and at the scheduled time). The newest 30 automatic backups are kept; manual backups are never removed automatically.</MudText>
    </MudPaper>

    <MudTable Items="backupFiles" Hover="true" Bordered="true" Striped="true">
        <ToolBarContent>
            <MudButton Class="ma-1" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" OnClick="Backup"
                       Disabled="@(busy || backupService.RestartRequired)">
                Backup
            </MudButton>
            @if (busy)
            {
                <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" Class="ml-2" />
            }
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Backup File</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Size</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Backup File">@context.Name</MudTd>
            <MudTd DataLabel="Type">@context.KindText</MudTd>
            <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Size">@context.SizeText</MudTd>
            <MudTd DataLabel="Actions">
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="() => RestoreBackup(context)"
                           Disabled="@(busy || backupService.RestartRequired)">
                    Restore
                </MudButton>
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Error" OnClick="() => DeleteBackup(context)"
                           Disabled="@busy">
                    Delete
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="text-center">Not Found!</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private List<BackupFileInfo> backupFiles = new();
    private DateTime? lastBackup;
    private bool busy;

    // Batch 17: appearance (colour and mode), set by MainLayout's CascadingValue.
    [CascadingParameter] public AppThemeState? Theme { get; set; }

    private async Task PickColour(string colour)
    {
        if (Theme is null) return;
        Theme.Set(colour, Theme.Mode);
        await JS.InvokeVoidAsync("inventoryTheme.save", Theme.Colour, Theme.Mode);
    }

    private async Task PickMode(string mode)
    {
        if (Theme is null) return;
        Theme.Set(Theme.Colour, mode);
        await JS.InvokeVoidAsync("inventoryTheme.save", Theme.Colour, Theme.Mode);
    }

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        backupFiles = backupService.GetBackupFiles();
        lastBackup = backupService.LastBackupTime;
    }

    private async Task Backup()
    {
        busy = true;
        try
        {
            await backupService.BackupDatabaseAsync();
            snackbar.Add("Backup created and checked successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            snackbar.Add("Failed to create backup. " + ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
            Reload();
        }
    }

    private async Task RestoreBackup(BackupFileInfo backup)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Restore",
            $"Replace ALL current data with the backup from {backup.CreatedAt:dd MMM yyyy HH:mm}? " +
            "Everything entered after that time will disappear. The current data is saved first as a 'Saved before a restore' backup.",
            "Restore",
            Color.Warning);
        if (!confirmed)
        {
            return;
        }

        busy = true;
        try
        {
            await backupService.RestoreDatabaseAsync(backup.Path);
            snackbar.Add("Backup restored. Close the app and start it again now.", Severity.Warning,
                o => o.RequireInteraction = true);
        }
        catch (Exception ex)
        {
            snackbar.Add("Failed to restore the backup. Your data was not changed. " + ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
            Reload();
        }
    }

    private async Task DeleteBackup(BackupFileInfo backup)
    {
        try
        {
            var confirmed = await DialogService.ConfirmAsync(
                "Delete",
                "Do you really want to delete these records? This process cannot be undone.",
                "Delete",
                Color.Error);
            if (confirmed)
            {
                backupService.DeleteBackup(backup.Path);
                snackbar.Add("Deleted the backup", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            snackbar.Add("Failed to delete the backup. " + ex.Message, Severity.Error);
        }
        finally
        {
            Reload();
        }
    }
}
