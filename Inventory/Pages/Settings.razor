@page "/settings"
@using Inventory.Service
@using Inventory.MudBlazorComponents
@inject BackupService backupService
@inject ISnackbar snackbar
@inject IDialogService DialogService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ActivityLogService Activity
@inject StockEntryService StockEntries
@inject ILogger<Settings> Logger

<PagesHeader Title="Settings" SubTitle="Reports, backups, overview" />

<MudContainer>
    @if (backupService.RestartRequired)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            A backup has been restored. Close the Inventory app completely and start it again before doing any more work.
        </MudAlert>
    }

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Appearance</MudText>
        <MudText Typo="Typo.subtitle2">Colour</MudText>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var colour in AppTheme.Colours)
            {
                var chosen = colour == (Theme?.Colour ?? "Teal");
                <MudButton Variant="MudBlazor.Variant.Filled" OnClick="() => PickColour(colour)"
                           Style="@($"background:{AppTheme.LightHex(colour)};color:#fff;min-width:92px;" + (chosen ? "outline:2px solid var(--mud-palette-text-primary);outline-offset:2px;" : ""))">
                    @colour
                </MudButton>
            }
        </div>
        <MudText Typo="Typo.subtitle2">Mode</MudText>
        <MudRadioGroup T="string" Value="@(Theme?.Mode ?? "System")" ValueChanged="PickMode">
            <MudRadio T="string" Value="@("Light")">Light</MudRadio>
            <MudRadio T="string" Value="@("Dark")">Dark</MudRadio>
            <MudRadio T="string" Value="@("System")">Same as Windows</MudRadio>
        </MudRadioGroup>
        <MudText Typo="Typo.caption">Applies at once. Remembered on this computer.</MudText>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Users and roles</MudText>
        <MudButton id="settings-users" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Href="/users">Users</MudButton>
        <MudButton id="settings-roles" Class="ml-2" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Href="/roles">Roles</MudButton>
        <MudText Typo="Typo.caption" Class="ml-2">Add users, give them roles, reset passwords; decide what each role may do.</MudText>
    </MudPaper>

    @* Stage 2, batches 2-7/2-8 (Hiten, 25-26 Nov 2026): the reasons list, and the Admin's approval switch (off unless switched on). *@
    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Stock changes</MudText>
        <div class="d-flex flex-wrap align-center gap-3">
            <MudButton id="settings-reasons" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Href="/reasons">Reasons</MudButton>
            <MudSwitch T="bool" Value="approvalOn" ValueChanged="SetApprovalAsync" Color="Color.Primary" Class="settings-approval"
                       Disabled="@(Access?.HasAdminRole != true || busy)">Stock changes need approval</MudSwitch>
            @if (waitingCount > 0)
            {
                <a href="/approvals" id="settings-waiting">@waitingCount waiting for approval</a>
            }
        </div>
        <MudText Typo="Typo.caption" Class="d-block mt-1">
            With approval on, damage, returns, repairs, write-offs, sending back and stock change entries move stock only after someone with
            "Approve stock changes" approves them. @(Access?.HasAdminRole == true ? "Only the Admin can switch this." : "Only the Admin can switch this; you can see it.")
        </MudText>
    </MudPaper>

    @* Stage 3, batch 3-2 (Hiten, 26 Nov 2026): the places that count stock and their racks. *@
    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Places and racks</MudText>
        <MudButton id="settings-places" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Href="/places">Places and racks</MudButton>
        <MudText Typo="Typo.caption" Class="ml-2">The shop, the godown and the racks inside them (addresses like 02-03-B).</MudText>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2"><b>Database:</b> @backupService.DatabasePath</MudText>
        <div class="d-flex flex-wrap align-center gap-2">
            <MudText Typo="Typo.body2"><b>Backup folder:</b> @backupService.BackupFolder</MudText>
            <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Tertiary" Size="MudBlazor.Size.Small" OnClick="ChangeFolder"
                       Disabled="@(busy || backupService.RestartRequired)">
                Change folder…
            </MudButton>
        </div>
        @if (!backupService.BackupFolderReachable)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">
                The backup folder cannot be reached, so no backups are being made. If it is on a USB drive, plug the drive in
                (the app tries again every hour), or choose another folder.
            </MudAlert>
        }
        else if (backupService.BackupsOnSameDiskAsData)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">
                Backups are on the same disk as the data. If this disk fails, both are lost. For safety, choose a folder on
                another drive, a USB drive that stays plugged in, or a OneDrive / Google Drive folder.
            </MudAlert>
        }
        <MudText Typo="Typo.body2">
            <b>Last backup:</b>
            @(lastBackup is null ? "none yet" : lastBackup.Value.ToString("dd MMM yyyy HH:mm"))
        </MudText>
        <MudText Typo="Typo.caption">An automatic backup is made every day (when the app starts, and at the scheduled time). The newest 30 automatic backups are kept; manual backups are never removed automatically.</MudText>
    </MudPaper>

    <MudTable Items="backupFiles" Hover="true" Bordered="true" Striped="true">
        <ToolBarContent>
            <MudButton Class="ma-1" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" OnClick="Backup"
                       Disabled="@(busy || backupService.RestartRequired)">
                Backup
            </MudButton>
            @if (busy)
            {
                <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" Class="ml-2" />
            }
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Backup File</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Size</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Backup File">@context.Name</MudTd>
            <MudTd DataLabel="Type">@context.KindText</MudTd>
            <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Size">@context.SizeText</MudTd>
            <MudTd DataLabel="Actions">
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="() => RestoreBackup(context)"
                           Disabled="@(busy || backupService.RestartRequired)">
                    Restore
                </MudButton>
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Error" OnClick="() => DeleteBackup(context)"
                           Disabled="@busy">
                    Delete
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="text-center">Not Found!</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private List<BackupFileInfo> backupFiles = new();
    private DateTime? lastBackup;
    private bool busy;

    // Batch 17: appearance (colour and mode), set by MainLayout's CascadingValue.
    [CascadingParameter] public AppThemeState? Theme { get; set; }
    [CascadingParameter] public UserAccess? Access { get; set; }

    // Stage 2, batch 2-8: the approval switch.
    private bool approvalOn;
    private int waitingCount;

    protected override async Task OnInitializedAsync()
    {
        approvalOn = await StockEntries.IsApprovalOnAsync();
        waitingCount = await StockEntries.WaitingCountAsync();
    }

    private async Task SetApprovalAsync(bool on)
    {
        var text = on
            ? "From now on every stock change waits for approval before it moves stock."
            : "From now on stock changes count at once. Anything already waiting still needs approving or rejecting.";
        if (!await DialogService.ConfirmAsync(on ? "Switch approval on?" : "Switch approval off?", text, on ? "Switch on" : "Switch off", Color.Primary, enterConfirms: true))
        {
            return;
        }

        try
        {
            await StockEntries.SetApprovalAsync(on, Access ?? UserAccess.Nobody);
            approvalOn = on;
            snackbar.Add(on ? "Stock changes now need approval." : "Stock changes no longer need approval.", Severity.Success);
        }
        catch (StockChangeRefused ex)
        {
            snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task PickColour(string colour)
    {
        if (Theme is null) return;
        Theme.Set(colour, Theme.Mode);
        await JS.InvokeVoidAsync("inventoryTheme.save", Theme.Colour, Theme.Mode);
    }

    private async Task PickMode(string mode)
    {
        if (Theme is null) return;
        Theme.Set(Theme.Colour, mode);
        await JS.InvokeVoidAsync("inventoryTheme.save", Theme.Colour, Theme.Mode);
    }

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        backupFiles = backupService.GetBackupFiles();
        lastBackup = backupService.LastBackupTime;
    }

    private async Task Backup()
    {
        busy = true;
        try
        {
            await backupService.BackupDatabaseAsync();
            snackbar.Add("Backup created and checked successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            snackbar.Add("Failed to create backup. " + ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
            Reload();
        }
    }

    private async Task ChangeFolder()
    {
        var parameters = new DialogParameters<FolderPickerDialog>
        {
            { x => x.StartFolder, backupService.BackupFolder },
            { x => x.StandardFolder, backupService.StandardBackupFolder }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FolderPickerDialog>("Choose the backup folder", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string folder)
        {
            return;
        }

        var problem = backupService.CheckNewBackupFolder(folder);
        if (problem is not null)
        {
            snackbar.Add(problem, Severity.Warning);
            return;
        }

        var oldFolder = backupService.BackupFolder;
        var copyExisting = false;
        if (backupFiles.Count > 0)
        {
            var answer = await DialogService.ShowMessageBoxAsync(
                "Backup folder",
                $"From now on backups will go to {folder}. Also copy the {backupFiles.Count} existing backup(s) there? " +
                $"(The originals stay in {oldFolder}.)",
                yesText: "Copy them", noText: "Don't copy", cancelText: "Cancel");
            if (answer is null)
            {
                return;
            }

            copyExisting = answer == true;
        }

        busy = true;
        try
        {
            var copied = await backupService.ChangeBackupFolderAsync(folder, copyExisting);
            await Activity.TryWriteAsync(ActivityLogService.Backup, $"Backup folder changed: {oldFolder} → {folder}", null, Logger);
            snackbar.Add(copyExisting
                ? $"Backups now go to {folder}. {copied} backup(s) copied there."
                : $"Backups now go to {folder}. Earlier backups are still in {oldFolder}.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            snackbar.Add("The backup folder was not changed. " + ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
            Reload();
        }
    }

    private async Task RestoreBackup(BackupFileInfo backup)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Restore",
            $"Replace ALL current data with the backup from {backup.CreatedAt:dd MMM yyyy HH:mm}? " +
            "Everything entered after that time will disappear. The current data is saved first as a 'Saved before a restore' backup.",
            "Restore",
            Color.Warning);
        if (!confirmed)
        {
            return;
        }

        busy = true;
        try
        {
            await backupService.RestoreDatabaseAsync(backup.Path);
            // Written into the restored data, so the restore itself is on record there.
            await Activity.TryWriteAsync(ActivityLogService.Backup, $"Backup restored: {System.IO.Path.GetFileName(backup.Path)} (made {backup.CreatedAt:dd-MM-yyyy HH:mm})", null, Logger);
            snackbar.Add("Backup restored. Close the app and start it again now.", Severity.Warning,
                o => o.RequireInteraction = true);
        }
        catch (Exception ex)
        {
            snackbar.Add("Failed to restore the backup. Your data was not changed. " + ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
            Reload();
        }
    }

    private async Task DeleteBackup(BackupFileInfo backup)
    {
        try
        {
            var confirmed = await DialogService.ConfirmAsync(
                "Delete",
                "Do you really want to delete these records? This process cannot be undone.",
                "Delete",
                Color.Error);
            if (confirmed)
            {
                backupService.DeleteBackup(backup.Path);
                await Activity.TryWriteAsync(ActivityLogService.Backup, $"Backup deleted: {System.IO.Path.GetFileName(backup.Path)} (made {backup.CreatedAt:dd-MM-yyyy HH:mm})", null, Logger);
                snackbar.Add("Deleted the backup", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            snackbar.Add("Failed to delete the backup. " + ex.Message, Severity.Error);
        }
        finally
        {
            Reload();
        }
    }
}
