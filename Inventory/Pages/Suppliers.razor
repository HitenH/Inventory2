@page "/suppliers"

@using Inventory.Models;

@if (!isLoaded)
{
    <LoadingComponent />
}
else
{
    <MudStack Spacing="20" Row="false">
        <div class="position-fixed z-3">
            <MudPaper>
                <MudToolBar>

                    <MudButton Class="ma-1" Href="/supplier" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary">Add New Supplier</MudButton>
                    <MudButton Class="ma-1" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" OnClick="OpenImportAsync">Import</MudButton>

                    <Search SearchItemCallBack="SearchItem" />
                </MudToolBar>
            </MudPaper>
        </div>
        <MudTable @ref="listTable" RowsPerPage="ListPaging.DefaultRowsPerPage" Items="suppliersAfterSearch" FixedHeader="true"
                  style="margin-top:6rem"
                  Dense="true" Bordered="true" Striped="true"
                  OnRowClick="@(EventCallback.Factory.Create<TableRowClickEventArgs<SuppliersDisplayModel>>(this, RowClickEvent))">
            <HeaderContent>
                <MudTh Style="width:140px">
                    <MudTableSortLabel SortBy="new Func<SuppliersDisplayModel, object>(x => x.SupplierId)">
                        Supplier ID
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SuppliersDisplayModel, object>(x => x.Name)">
                        Name
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="width:150px">
                    <MudTableSortLabel SortBy="new Func<SuppliersDisplayModel, object>(x => x.Mobiles.FirstOrDefault()?.Phone ?? string.Empty)">
                        Mobile
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="width:160px">
                    <MudTableSortLabel SortBy="new Func<SuppliersDisplayModel, object>(x => x.Area)">
                        Area
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Class="num" Style="width:130px">
                    <MudTableSortLabel SortBy="new Func<SuppliersDisplayModel, object>(f => f.TotalAmount)">
                        Amount
                    </MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SupplierId</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@(context.Mobiles?.Count > 0 ? context.Mobiles.First().Phone : "-")</MudTd>
                <MudTd>@context.Area</MudTd>
                <MudTd Class="num">@context.TotalAmount</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.h6" Align="Align.Center">Not Found!</MudText>
            </NoRecordsContent>
            <PagerContent>
                <ListPager />
            </PagerContent>
        </MudTable>
    </MudStack>

}

