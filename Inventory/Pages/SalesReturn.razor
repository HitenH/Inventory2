@page "/salesreturn/{returnId?}"
@using Inventory.Shared.Selectors
@using Inventory.Service
@* Stage 2, batch 2-4 (Hiten, 25 Nov 2026): a sales return - goods a customer brings back. Laid out like a purchase:
   customer, voucher, date and buttons on top; the lines (quantities only, the same line editor as Purchase); and a bar
   with "Record damage", remarks and the total pieces. The returned pieces go into sellable stock; damaged ones are
   moved with "Record damage", as on a purchase. *@

<FocusOnOpen Selector="@(ReturnId == null ? ".focus-customer" : ".focus-line-product")" />

<EditForm Model="@header" class="card-header mt-2 head-card" OnValidSubmit="SaveHeaderAsync">
    <div class="head-row">
        <div class="field field-wide">
            <label class="form-label"><h4>Customer</h4></label>
            <CustomerAutocomplete T="CustomerModel" Class="focus-customer" EnterPressed="OnCustomerEnter"
                                  SelectedCustomer="selectedCustomer" SelectedCustomerChanged="OnCustomerSelected" />
        </div>
        <div class="field field-voucher">
            <label for="voucher" class="form-label"><h4>Voucher</h4></label>
            <input id="voucher" class="form-control text-center" value="@(salesReturn?.VoucherId.ToString() ?? "")" disabled title="Given when saved" />
        </div>
        <div class="field field-date">
            <label for="date" class="form-label"><h4>Date</h4></label>
            <DateBox TValue="DateOnly" @bind-Value="header.Date" Style="width:168px;" OpenLeft="true" />
        </div>
        <div class="head-actions">
            @if (ReturnId == null)
            {
                <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-success">Save</button>
            }
            else
            {
                <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-warning">Update</button>
            }
            <NavLink type="button" href="/salesreturns" id="button-close" class="btn btn-info">Close</NavLink>
            @if (ReturnId != null)
            {
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
                <ActivityLogButton RecordType="@nameof(Inventory.Domain.Entities.StockChangeEntity)" RecordId="@ReturnId" Title="Sales return" />
            }
            <NavLink class="btn btn-secondary" href="/">Home</NavLink>
        </div>
    </div>
</EditForm>

@if (ReturnId != null && salesReturn != null)
{
    <TransactionLineEditor Lines="lines" ChangeState="LinesChangedAsync" />

    <div class="card-header mt-3">
        <div class="totals-bar">
            <div class="totals-actions">
                @if (Access?.Allows(Permissions.StockDamage) == true && lines.Load().Count > 0)
                {
                    <MudButton id="salesreturn-record-damage" Variant="MudBlazor.Variant.Filled" Color="Color.Default" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.BrokenImage" OnClick="RecordDamageAsync">Record damage</MudButton>
                }
                @* Hiten, 26 Nov 2026: goods given to the customer in exchange go out of stock on the same return. *@
                <MudButton id="salesreturn-exchange" Variant="MudBlazor.Variant.Filled" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="GiveInExchangeAsync">Given in exchange</MudButton>
                <button type="button" id="salesreturn-save-close" class="btn btn-success" @onclick="SaveAndCloseAsync">Save</button>
            </div>
            <div class="field totals-remarks">
                <label for="Remarks" class="form-label">Remarks / Narration</label>
                <InputText @bind-Value="header.Remarks" id="Remarks" class="form-control text-start" />
            </div>
            <div class="field totals-field">
                <label for="totalquantity" class="form-label">Returned</label>
                <input id="totalquantity" class="form-control text-center" value="@TotalPieces" disabled />
            </div>
            <div class="field totals-field">
                <label for="totalgiven" class="form-label">Given</label>
                <input id="totalgiven" class="form-control text-center" value="@GivenPieces" disabled />
            </div>
        </div>
    </div>

    @if (Given.Count > 0)
    {
        <div class="card-header mt-3 exchange-card">
            <div class="exchange-title">Given in exchange</div>
            <table class="table table-striped table-bordered table-sm mb-0 lines-table exchange-table">
                <thead>
                    <tr>
                        <th class="c-act"></th>
                        <th class="c-sl num">Sl.</th>
                        <th class="c-pid">Product ID</th>
                        <th class="c-name">Product Name</th>
                        <th class="c-vid">Variant ID</th>
                        <th class="c-qty num">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Given)
                    {
                        <tr class="exchange-row">
                            <td class="c-act">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" title="Remove this line"
                                               OnClick="() => RemoveGivenAsync(line.Id)" Class="exchange-remove" />
                            </td>
                            <td class="c-sl num">@line.SerialNumber</td>
                            <td class="c-pid">@line.Product?.ProductId</td>
                            <td class="c-name" title="@line.Product?.Name">@line.Product?.Name</td>
                            <td class="c-vid">@line.ProductVariant?.VariantId</td>
                            <td class="c-qty num">@line.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
