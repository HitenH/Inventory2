@page "/purchasereturn/{returnId?}"
@using Inventory.Shared.Selectors
@* Stage 2, batch 2-6 (Hiten, 25 Nov 2026): a purchase return - goods sent back to a supplier. Made by "Sent" on the damage
   report (the damaged goods are listed with where they were found), or directly for good stock (the line editor below,
   quantities only). After a purchase return nothing is tracked: what comes back is a new purchase. *@

<FocusOnOpen Selector="@(ReturnId == null ? ".focus-supplier" : ".focus-line-product")" />

<EditForm Model="@header" class="card-header mt-2 head-card" OnValidSubmit="SaveHeaderAsync">
    <div class="head-row">
        <div class="field field-wide">
            <label class="form-label"><h4>Supplier</h4></label>
            <SupplierAutocomplete T="SupplierModel" Class="focus-supplier" EnterPressed="OnSupplierEnter"
                                  SelectedSupplier="selectedSupplier" SelectedSupplierChanged="OnSupplierSelected" />
        </div>
        <div class="field field-voucher">
            <label for="voucher" class="form-label"><h4>Voucher</h4></label>
            <input id="voucher" class="form-control text-center" value="@(purchaseReturn?.VoucherId.ToString() ?? "")" disabled title="Given when saved" />
        </div>
        <div class="field field-date">
            <label for="date" class="form-label"><h4>Date</h4></label>
            <DateBox TValue="DateOnly" @bind-Value="header.Date" Style="width:168px;" OpenLeft="true" />
        </div>
        <div class="head-actions">
            @if (ReturnId == null)
            {
                <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-success">Save</button>
            }
            else
            {
                <button type="submit" data-shortcut="save" id="button-submit" class="btn btn-warning">Update</button>
            }
            <NavLink type="button" href="/purchasereturns" id="button-close" class="btn btn-info">Close</NavLink>
            @if (ReturnId != null)
            {
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
                <ActivityLogButton RecordType="@nameof(Inventory.Domain.Entities.StockChangeEntity)" RecordId="@ReturnId" Title="Purchase return" />
            }
            <NavLink class="btn btn-secondary" href="/">Home</NavLink>
        </div>
    </div>
</EditForm>

@if (ReturnId != null && purchaseReturn != null)
{
    @if (FromDamage.Count > 0)
    {
        <div class="card-header mt-3 exchange-card">
            <div class="exchange-title">Damaged goods sent back</div>
            <table class="table table-striped table-bordered table-sm mb-0 lines-table fromdamage-table">
                <thead>
                    <tr>
                        <th class="c-act"></th>
                        <th class="c-sl num">Sl.</th>
                        <th class="c-pid">Product ID</th>
                        <th class="c-name">Product Name</th>
                        <th class="c-vid">Variant ID</th>
                        <th class="c-qty num">Qty</th>
                        <th class="c-from">Found on</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in FromDamage)
                    {
                        <tr class="fromdamage-row">
                            <td class="c-act">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" title="Not sent after all: back onto the damage report"
                                               OnClick="() => RemoveAsync(line.Id)" Class="fromdamage-remove" />
                            </td>
                            <td class="c-sl num">@line.SerialNumber</td>
                            <td class="c-pid">@line.Product?.ProductId</td>
                            <td class="c-name" title="@line.Product?.Name">@line.Product?.Name</td>
                            <td class="c-vid">@line.ProductVariant?.VariantId</td>
                            <td class="c-qty num">@line.Quantity</td>
                            <td class="c-from">@sources.GetValueOrDefault(line.Id)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3 exchange-title">Good stock sent back</div>
    <TransactionLineEditor Lines="lines" ChangeState="LinesChangedAsync" />

    <div class="card-header mt-3">
        <div class="totals-bar">
            <div class="totals-actions">
                <button type="button" id="purchasereturn-save-close" class="btn btn-success" @onclick="SaveAndCloseAsync">Save</button>
            </div>
            <div class="field totals-remarks">
                <label for="Remarks" class="form-label">Remarks / Narration</label>
                <InputText @bind-Value="header.Remarks" id="Remarks" class="form-control text-start" />
            </div>
            <div class="field totals-field">
                <label for="totalfromdamage" class="form-label">From damage</label>
                <input id="totalfromdamage" class="form-control text-center" value="@FromDamage.Sum(l => l.Quantity)" disabled />
            </div>
            <div class="field totals-field">
                <label for="totalgood" class="form-label">Good stock</label>
                <input id="totalgood" class="form-control text-center" value="@GoodPieces" disabled />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ReturnId { get; set; }

    [Inject] private DamagedGoodsService DamagedGoods { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ILogger<PurchaseReturn> Logger { get; set; } = default!;

    private sealed class Header
    {
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Now);
        public string? Remarks { get; set; }
    }

    private readonly Header header = new();
    private SupplierModel? selectedSupplier;
    private Inventory.Domain.Entities.StockChangeEntity? purchaseReturn;
    private TransactionLines lines = default!;
    private Dictionary<Guid, string> sources = new();

    private List<Inventory.Domain.Entities.StockChangeLineEntity> FromDamage =>
        purchaseReturn?.Lines.Where(l => l.From == Inventory.Domain.Entities.StockState.Damaged).OrderBy(l => l.SerialNumber).ToList() ?? [];

    private int GoodPieces => purchaseReturn?.Lines.Where(l => l.From == Inventory.Domain.Entities.StockState.Sellable).Sum(l => l.Quantity) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        if (ReturnId != null)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (!Guid.TryParse(ReturnId, out var id) || await DamagedGoods.GetPurchaseReturnAsync(id) is not { } loaded)
        {
            Snackbar.Add("This purchase return was not found.", Severity.Warning);
            Nav.NavigateTo("/purchasereturns");
            return;
        }

        purchaseReturn = loaded;
        lines = new PurchaseReturnLines(loaded, DamagedGoods);
        sources = await DamagedGoods.SourcesAsync(loaded);
        header.Date = loaded.Date;
        header.Remarks = loaded.Remarks;
        selectedSupplier = loaded.Supplier?.ToModel();
    }

    private async Task OnSupplierEnter(SupplierModel _)
    {
        if (ReturnId == null)
        {
            await SaveHeaderAsync();
        }
        else
        {
            await JS.FocusBoxAsync(".focus-line-product");
        }
    }

    private void OnSupplierSelected(SupplierModel? supplier) => selectedSupplier = supplier is { Id: var id } && id != Guid.Empty ? supplier : null;

    private async Task SaveHeaderAsync()
    {
        if (selectedSupplier is null || selectedSupplier.Id == Guid.Empty)
        {
            Snackbar.Add("Please select a supplier.", Severity.Warning);
            return;
        }

        try
        {
            if (ReturnId == null)
            {
                var created = await DamagedGoods.CreatePurchaseReturnAsync(selectedSupplier.Id, header.Date, header.Remarks);
                ReturnId = created.Id.ToString();
                await ReloadAsync();
                await JS.FocusBoxAsync(".focus-line-product");
            }
            else
            {
                await DamagedGoods.UpdatePurchaseReturnAsync(purchaseReturn!.Id, selectedSupplier.Id, header.Date, header.Remarks);
                await ReloadAsync();
                Snackbar.Add("Purchase return updated.", Severity.Success);
            }
        }
        catch (StockChangeRefused ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save purchase return failed");
            Snackbar.Add($"Could not save the purchase return: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAndCloseAsync()
    {
        if (purchaseReturn is null || selectedSupplier is null)
        {
            return;
        }

        try
        {
            await DamagedGoods.UpdatePurchaseReturnAsync(purchaseReturn.Id, selectedSupplier.Id, header.Date, header.Remarks);
            Nav.NavigateTo("/purchasereturns");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save purchase return failed");
            Snackbar.Add($"Could not save the purchase return: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync()
    {
        if (purchaseReturn is null || !await DialogService.ConfirmDeleteAsync())
        {
            return;
        }

        try
        {
            await DamagedGoods.DeletePurchaseReturnAsync(purchaseReturn.Id);
            Snackbar.Add("Purchase return deleted. Damaged goods on it are back on the damage report.", Severity.Success);
            Nav.NavigateTo("/purchasereturns");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete purchase return failed");
            Snackbar.Add("Could not delete the purchase return.", Severity.Error);
        }
    }

    private async Task RemoveAsync(Guid lineId)
    {
        try
        {
            await DamagedGoods.DeletePurchaseReturnLineAsync(lineId);
            Snackbar.Add("Back on the damage report.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing a line of a purchase return failed");
            Snackbar.Add($"Could not remove the line: {ex.Message}", Severity.Error);
        }
    }

    private async Task LinesChangedAsync(bool changed)
    {
        if (changed)
        {
            await ReloadAsync();
            StateHasChanged();
        }
    }
}
