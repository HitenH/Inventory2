@page "/users"
<PageTitle>Users</PageTitle>

<Inventory.MudBlazorComponents.PagesHeader Title="Users" SubTitle="Who can log in, and what they may do" />

<MudContainer>
    @if (!loaded)
    {
        <Inventory.MudBlazorComponents.LoadingComponent />
    }
    else if (!mayManage)
    {
        <MudAlert Severity="Severity.Warning" id="users-no-access">You do not have access to this screen.</MudAlert>
    }
    else
    {
        <MudTable Items="rows" Hover="true" Bordered="true" Striped="true" Dense="true">
            <ToolBarContent>
                <MudButton id="user-add-open" Class="ma-1" Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="AddUser">+ Add user</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Places</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Roles">@RolesText(context)</MudTd>
                <MudTd DataLabel="Places" Class="user-places-text">@PlacesText(context)</MudTd>
                <MudTd DataLabel="Status">@(context.IsDisabled ? "Disabled" : "Active")</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Class="user-roles" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Size="MudBlazor.Size.Small" OnClick="() => EditRoles(context)">Roles</MudButton>
                    <MudButton Class="user-places-open" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Size="MudBlazor.Size.Small" OnClick="() => EditPlaces(context)">Places</MudButton>
                    <MudButton Class="user-password" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Size="MudBlazor.Size.Small" OnClick="() => ResetPassword(context)">Password</MudButton>
                    @if (context.IsDisabled)
                    {
                        <MudButton Class="user-enable" Variant="MudBlazor.Variant.Filled" Color="Color.Secondary" Size="MudBlazor.Size.Small" OnClick="() => Enable(context)">Enable</MudButton>
                    }
                    else
                    {
                        <MudButton Class="user-disable" Variant="MudBlazor.Variant.Filled" Color="Color.Error" Size="MudBlazor.Size.Small" OnClick="() => Disable(context)">Disable</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="text-center">Not Found!</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudContainer>
