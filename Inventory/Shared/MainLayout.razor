@inherits LayoutComponentBase
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (!_layoutReady)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <p class="text-muted">Loading Inventory Store...</p>
    </div>
}
else
{
    <MudThemeProvider @ref="@_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" />
    @* "app-dark" switches the Bootstrap tables, text boxes, panels and icons to dark colours (site.css);
       the pop-ups are inside it so their contents follow too. *@
    <div class="@(_isDarkMode ? "app-dark" : null)">
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
            <MudSpacer />
            @* Keyboard shortcut list in a floating window; a click anywhere else closes it. *@
            <MudTooltip Text="Keyboard shortcuts">
                <MudMenu Icon="@Icons.Material.Filled.Keyboard" Color="Color.Inherit" AriaLabel="Keyboard shortcuts"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <div class="pa-4">
                        <ShortcutLegend />
                    </div>
                </MudMenu>
            </MudTooltip>
            <MudSwitch @bind-Value="_isDarkMode" Color="Color.Primary" Class="ma-4" T="bool" Label="Toggle Light/Dark Mode" />
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="2"
                   Variant="DrawerVariant.Persistent"
                   ClipMode="DrawerClipMode.Always">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6" Class="px-4">Inventory Store</MudText>
            </MudDrawerHeader>
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            <MudContainer Class="mt-2 px-8" MaxWidth="MaxWidth.ExtraExtraLarge">
                @if (Backups.RestartRequired)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">
                        A backup was restored. Close the Inventory app and start it again before entering anything else.
                    </MudAlert>
                }
                @* Batch 9: an error on one screen shows this box (and goes to the log file) instead of stopping the whole app. *@
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <MudAlert Severity="Severity.Error" Class="my-4">
                            Something went wrong on this screen. Anything not yet saved on it may be lost.
                            Press <b>Try again</b>, or open another screen from the menu. The details were written to the log file.
                        </MudAlert>
                        <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="RecoverFromError">Try again</MudButton>
                    </ErrorContent>
                </ErrorBoundary>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
    </div>
}

@code {
    [Inject] private Inventory.Service.BackupService Backups { get; set; } = default!;

    // Subscribe so the "restart required" bar appears as soon as a restore finishes.
    protected override Task OnInitializedAsync()
    {
        Backups.RestartRequiredChanged += OnRestartRequiredChanged;
        return Task.CompletedTask;
    }

    private void OnRestartRequiredChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Backups.RestartRequiredChanged -= OnRestartRequiredChanged;
        _shortcutsRef?.Dispose();
    }

    // Keyboard shortcuts (Service/Shortcuts.cs): shortcuts.js catches Alt + letter and calls OnShortcut.
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private DotNetObjectReference<MainLayout>? _shortcutsRef;

    [JSInvokable]
    public Task OnShortcut(string letter, bool shift)
    {
        if (string.IsNullOrEmpty(letter))
        {
            return Task.CompletedTask;
        }

        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = Inventory.Service.Shortcuts.Target(currentPath, letter[0], shift);
        if (target is not null)
        {
            // Staying on the same screen (e.g. new sale from a sale) reloads it, so the form starts empty.
            Navigation.NavigateTo(target, forceLoad: Inventory.Service.Shortcuts.NeedsReload(currentPath, target));
        }
        return Task.CompletedTask;
    }

    /// <summary>Esc: back to the list, and from a list to the Dashboard (Service/Shortcuts.Back).</summary>
    [JSInvokable]
    public Task OnBack()
    {
        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = Inventory.Service.Shortcuts.Back(currentPath);
        if (target is not null)
        {
            Navigation.NavigateTo(target);
        }
        return Task.CompletedTask;
    }

    private ErrorBoundary? _errorBoundary;

    // Opening another screen clears the error box.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void RecoverFromError() => _errorBoundary?.Recover();

    private bool _layoutReady;
    private bool _isDarkMode;
    private bool _themeWatcherStarted;
    private MudThemeProvider? _mudThemeProvider;
    private bool _drawerOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _layoutReady = true;
            _shortcutsRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("inventoryShortcuts.init", _shortcutsRef, Inventory.Service.Shortcuts.Letters);
            StateHasChanged();
            return;
        }

        if (!_themeWatcherStarted && _mudThemeProvider is not null)
        {
            _themeWatcherStarted = true;
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemPreferenceChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
