@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Batch 17 round 3: boxes wrap onto a second line on a narrow screen instead of squeezing the buttons out of sight;
   outlined boxes with the label on the border, like the rest of the app. *@
<MudPaper Class="pa-4 variant-card" Outlined="true">
    <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600;">Variants</MudText>
    <EditForm EditContext="editContext" OnSubmit="async () => await (variantModel.Id == Guid.Empty ? AddVariant() : EditVariant())">
        <DataAnnotationsValidator />
        <div class="variant-row">
            <MudTextField Label="Variant ID" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Class="vf-id"
                          @ref="variantInputRef"
                          @bind-Value="variantModel.VariantId"
                          InputType="InputType.Text" />
            <MudTextField Label="Variant Name" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Class="vf-name"
                          @bind-Value="variantModel.Name"
                          InputType="InputType.Text" />
            <MudTextField Label="Stock In Hand" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Class="vf-num"
                          @bind-Value="variantModel.StockInHand"
                          Disabled
                          InputType="InputType.Number" />
            <MudTextField Label="Reorder Level" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" Class="vf-num"
                          @bind-Value="variantModel.ReorderLevel"
                          InputType="InputType.Number" />
            <div class="field vf-file">
                <label for="image" class="form-label">Image (jpeg)</label>
                @if (!bclearinputfile)
                {
                    <InputFile OnChange="UploadFile" accept=".jpg, .jpeg" class="form-control" />
                }
            </div>
            <div class="vf-actions">
                <MudIconButton Color="Color.Primary" Variant="MudBlazor.Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Add" ButtonType="MudBlazor.ButtonType.Submit" title="Add / save variant" />
                <MudIconButton Color="Color.Error" Variant="MudBlazor.Variant.Filled" Size="Size.Small" OnClick="CancelVariant" Icon="@Icons.Material.Filled.Close" title="Cancel" />
            </div>
        </div>
        <ValidationSummary />
    </EditForm>
</MudPaper>
<MudTable Items="variants" Dense="true" Bordered="true" Striped="false" Outlined="true" Elevation="0" Class="mt-2">
    <HeaderContent>
        <MudTh></MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.VariantId)">
                Variant ID
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.Name)">
                Name
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.StockInHand)">
                Stock In Hand
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.ReorderLevel)">
                Reorder Level
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<VariantModel, object>(x => x.Image)">
                Image
            </MudTableSortLabel>
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudIconButton Variant="MudBlazor.Variant.Filled" Color="Color.Tertiary" Size="Size.Small" OnClick="() => UpdateVariant(context)" Icon="@Icons.Material.Filled.Edit">
            </MudIconButton>
            <MudIconButton Variant="MudBlazor.Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteVariant(context.Id)" Icon="@Icons.Material.Filled.Delete">
            </MudIconButton>
        </MudTd>
        <MudTd>@context.VariantId</MudTd>
        <MudTd Class="c-vname-p" title="@context.Name">@context.Name</MudTd>
        <MudTd>@(stockInHand.TryGetValue(context.Id, out var qty) ? qty : 0)</MudTd>
        <MudTd>@context.ReorderLevel</MudTd>
        <MudTd>
            @if (context.Image != null)
            {
                <MudImage Src="@GetImage(context.Image)"
                          Width="56"
                          Height="56"
                          Alt="@($"Photo of variant {context.VariantId}")"
                          @onclick="() => OpenImagePopup(context.Image)"
                          Elevation="25"
                          Class="rounded-lg ma-1" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="async () => await DeleteFile(context.Image)"
                               Variant="MudBlazor.Variant.Filled">
                </MudIconButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudTd Class="text-center">Not Found!</MudTd>
    </NoRecordsContent>
</MudTable>