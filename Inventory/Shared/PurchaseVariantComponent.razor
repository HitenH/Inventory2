@* Purchase lines: the shared line editor (batch 12) pointed at this purchase. *@
@using Inventory.Domain.Entities
@using Inventory.Domain.Repository.Abstract

<TransactionLineEditor Lines="lines" ChangeState="ChangeState" />

@code {
    [Parameter] public PurchaseEntity Purchase { get; set; } = default!;
    [Parameter] public EventCallback<bool> ChangeState { get; set; }
    [Inject] private IPurchaseVariantRepository PurchaseVariantRepository { get; set; } = default!;

    private TransactionLines lines = default!;

    protected override void OnParametersSet() => lines = new PurchaseLines(Purchase, PurchaseVariantRepository);
}
