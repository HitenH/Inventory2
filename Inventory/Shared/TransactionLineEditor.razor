@* Shared line editor for Purchase and Sales Order (batch 12). *@
@using Inventory.Shared.Selectors


<EditForm Model="@line" class="card-header mt-3 enter-moves-on"
          OnValidSubmit="async ()=>
                {
                    if(line.Id == Guid.Empty){
                        await AddLine();
                }
                    else{
                        await EditLine();
                } }">
    <DataAnnotationsValidator />
    <div class="lineform">
    <div class="lineform-a">
        <div class="d-flex justify-content-around align-items-center">
            <button type="submit" id="button-submit" class="btn btn-light btn-order-add" data-enter-submit>
                <img src="img/add.png" alt="add" class="order-add-img" />
            </button>
            <button type="button" id="button-close" class="btn btn-light btn-cancel-add" @onclick="CancelLine">
                <img src="img/cancel.png" alt="cancel" class="purchase-cancel-img" />
            </button>
            @* Batch 17: the Bulk Entry button moved to the page's totals bar (owner's request), so this row fits on one line. *@
        </div>
        <div class="field field-sl">
            <label for="serialnumber" class="form-label">Sl.</label>
            <InputNumber @bind-Value="serialnumber" id="serialnumber" class="form-control text-center" />
        </div>
        <div class="field field-prod">
            
            <label for="variantid" class="form-label">Product Selection</label>
            <ProductAutocomplete T="ProductModel" Class="focus-line-product" EnterPressed="OnProductEnter"
                        SelectedProduct="selectedProduct"
                        SelectedProductChanged="OnProductSelected" />

            <InputText @bind-Value="line.ProductId" class="form-control text-center" disabled hidden />
            <InputText @bind-Value="line.ProductName" class="form-control text-center" disabled hidden />

        </div>
        <div class="field field-var">
            <label for="variantid" class="form-label">Variant ID</label>
            @if (product.Variants.Count != 0)
            {
                <InputSelect @bind-Value="line.VariantEntityId" class="form-control text-center" id="variantid">
                    <option value="" class="text-center">-</option>
                    @if (product.Variants.Count != 0)
                    {
                        @foreach (var item in product.Variants)
                        {
                            if (item.Id == line.VariantEntityId)
                            {
                                <option selected value="@item.Id" class="text-center">@item.DisplayText</option>
                            }
                            else
                            {
                                <option value="@item.Id" class="text-center">@item.DisplayText</option>
                            }
                        }
                    }
                </InputSelect>
            }
            else
            {
                <input class="form-control text-center" value="@line.ProductVariantId" disabled />
            }

        </div>
    </div>
    <div class="lineform-b">
        <div class="field field-num">
            <label for="quantity" class="form-label" title="Quantity">Qty</label>
            <MudNumericField T="int?" Value="line.Quantity" ValueChanged="(value)=>QuantityChanged(value)" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="box-center" />
        </div>
        <div class="field field-num">
            <label for="rate" class="form-label">Rate</label>
            <MudNumericField T="decimal?" Value="line.ProductRate" ValueChanged="(value)=>RateChanged(value)" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="box-center" />
        </div>
        <div class="field field-num">
            <label for="amount" class="form-label">Amount</label>
            <MudNumericField T="decimal?" @bind-Value="line.Amount" Disabled="true" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="box-center" />
        </div>
        <div class="field field-num">
            <label for="discount" class="form-label" title="Discount (%)">Disc %</label>
            <MudNumericField T="int?" Value="line.DiscountPercent" ValueChanged="(value)=>DiscountChanged(value)" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="box-center" />
        </div>
        <div class="field field-num">
            <label for="amountafterdiscount" class="form-label">Amount</label>
            <InputNumber @bind-Value="line.AmountAfterDiscount" id="amountafterdiscount" class="form-control text-center" disabled />
        </div>
        @if (Lines.HasRemarks)
        {
            <div class="field field-rem">
                <label for="remarks" class="form-label">Remarks</label>
                <InputText @bind-Value="line.Remarks" id="remarks" class="form-control text-center" />
            </div>
        }
    </div>
    </div>
    <ValidationSummary />
</EditForm>


<table class="table table-striped table-bordered mt-2 lines-table">
    <thead>
        <tr>
            <th class="c-act"></th>
            <th class="c-sl num column-item" @onclick="@(()=>SortItem("SerialNumber"))">Sl.</th>
            <th class="c-pid column-item" @onclick="@(()=>SortItem("ProductId"))">Product ID</th>
            <th class="c-name column-item" @onclick="@(()=>SortItem("ProductName"))">Product Name</th>
            <th class="c-vid column-item" @onclick="@(()=>SortItem("VariantId"))">Variant ID</th>
            <th class="c-qty num column-item" @onclick="@(()=>SortItem("Quantity"))">Qty</th>
            <th class="c-rate num column-item" @onclick="@(()=>SortItem("ProductRate"))">Rate</th>
            <th class="c-amt num column-item" @onclick="@(()=>SortItem("Amount"))">Amount</th>
            <th class="c-disc num column-item" @onclick="@(()=>SortItem("DiscountPercent"))">Disc %</th>
            <th class="c-amt2 num column-item" @onclick="@(()=>SortItem("AmmountAfterDiscount"))">Amount</th>
            @if (Lines.HasRemarks)
            {
                <th class="c-rem column-item" @onclick="@(()=>SortItem("Remarks"))">Remarks</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (lines.Count != 0)
        {
            @foreach (var variant in lines)
            {
                <tr>
                    <td class="c-act">
                        <div>
                            <button class="btn btn-light btn-variant-edit">
                                <img src="img/edit.png" alt="add" class="variant-edit-img" @onclick="()=>EditLineClicked(variant)" />
                            </button>
                            <button class="btn btn-light btn-variant-delete">
                                <img src="img/delete.png" alt="add" class="variant-delete-img" @onclick="()=>DeleteLine(variant.Id)" />
                            </button>
                        </div>
                    </td>
                    <td class="c-sl num">@variant.SerialNumber</td>
                    <td class="c-pid">@variant.ProductId</td>
                    <td class="c-name" title="@variant.ProductName">@variant.ProductName</td>
                    <td class="c-vid">@variant.ProductVariantId</td>
                    <td class="c-qty num">@variant.Quantity</td>
                    <td class="c-rate num">@variant.ProductRate</td>
                    <td class="c-amt num">@variant.Amount</td>
                    <td class="c-disc num">@variant.DiscountPercent</td>
                    <td class="c-amt2 num">@variant.AmountAfterDiscount</td>
                    @if (Lines.HasRemarks)
                    {
                        <td class="c-rem">@variant.Remarks</td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="12" class="text-center">
                    Not Found!
                </td>
            </tr>
        }
    </tbody>
</table>