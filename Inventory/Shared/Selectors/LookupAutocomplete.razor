@* Search box + "pick from list" button for customers, suppliers and products (batch 12; one copy instead of three). *@
@using Inventory.MudBlazorComponents
@typeparam TItem

@* The button takes only its own width; the name box gets all the rest (batch 13: names were cut off). *@
<div class="d-flex align-items-center">
    <div class="me-2">
        <MudIconButton Color="Color.Secondary" Variant="MudBlazor.Variant.Filled" OnClick="OpenDialogAsync"
                       Icon="@Icons.Material.Filled.AdsClick">
        </MudIconButton>
    </div>
    <div class="flex-grow-1" style="min-width:0;">
        @* Batch 13: MudAutocomplete replaces the Blazor.Bootstrap AutoComplete. Starts searching from the first letter,
           shows every match (no limit, as before), has its own clear ("x") button and shows the picked name. *@
        <MudAutocomplete T="TItem"
                         Value="selected"
                         ValueChanged="OnAutoCompleteChanged"
                         SearchFunc="Search"
                         ToStringFunc="DisplayName"
                         Placeholder="@Settings.Placeholder"
                         MinCharacters="1"
                         MaxItems="null"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         Dense="true"
                         Adornment="Adornment.None"
                         Variant="MudBlazor.Variant.Outlined"
                         Margin="Margin.Dense" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public LookupSettings<TItem> Settings { get; set; } = default!;
    /// <summary>Loads the list the search box searches.</summary>
    [Parameter, EditorRequired] public Func<Task<List<TItem>>> LoadForSearch { get; set; } = default!;
    /// <summary>Loads the list shown in the pop-up.</summary>
    [Parameter, EditorRequired] public Func<Task<List<TItem>>> LoadForDialog { get; set; } = default!;
    [Parameter] public EventCallback<TItem> SelectedItemChanged { get; set; }
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ILogger<LookupAutocomplete<TItem>> Logger { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private TItem? selected;
    private List<TItem> items = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var loaded = await LoadForSearch();
            if (loaded.Count != 0)
            {
                items = loaded;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{What}", Settings.SearchBoxLoadFailedLog);
            Snackbar.Add(Settings.SearchBoxLoadFailedMessage, Settings.SearchBoxLoadFailedSeverity);
        }
    }

    private Task<IEnumerable<TItem>> Search(string? search, CancellationToken cancellationToken)
        => Task.FromResult(Lookups.SearchBoxMatches(items, Settings, search));

    private string DisplayName(TItem? item) => item is null ? "" : Settings.NameOf(item) ?? "";

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            CloseOnEscapeKey = true,
            CloseButton = true,
            Position = DialogPosition.Center
        };
        var parameters = new DialogParameters<LookupDialog<TItem>>
        {
            { x => x.Settings, Settings },
            { x => x.LoadItems, LoadForDialog }
        };
        var dialog = await DialogService.ShowAsync<LookupDialog<TItem>>(Settings.DialogTitle, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: TItem selected })
        {
            this.selected = selected;
            await SelectedItemChanged.InvokeAsync(selected);
        }
    }

    private async Task OnAutoCompleteChanged(TItem? item)
    {
        selected = item;
        await SelectedItemChanged.InvokeAsync(item!);
    }
}
