@* Customer picker: the shared search box + pop-up (batch 12) with the customer settings. *@
@using Inventory.Domain.Repository.Abstract
@typeparam T

<LookupAutocomplete Class="@Class" EnterPressed="EnterPressed" TItem="CustomerModel" Settings="Lookups.Customer"
                    LoadForSearch="LoadForSearch" LoadForDialog="LoadForDialog"
                    Selected="SelectedCustomer" SelectedItemChanged="SelectedCustomerChanged" />

@code {
    /// <summary>Extra CSS class, e.g. to put the cursor in this box when the screen opens.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Enter pressed with a name chosen: the screen moves on (see LookupAutocomplete).</summary>
    [Parameter] public EventCallback<CustomerModel> EnterPressed { get; set; }
    [Parameter] public EventCallback<CustomerModel> SelectedCustomerChanged { get; set; }
    [Parameter] public CustomerModel SelectedCustomer { get; set; }
    [Inject] private ICustomerRepository CustomerRepository { get; set; } = default!;

    private async Task<List<CustomerModel>> LoadForSearch() =>
        (await CustomerRepository.GetAllForLookup()).Select(c => c.ToModel()).ToList();

    // The pop-up searches phone numbers too, so it loads customers with their phones.
    private async Task<List<CustomerModel>> LoadForDialog() =>
        (await CustomerRepository.GetAll()).Select(c => c.ToModel()).ToList();
}
