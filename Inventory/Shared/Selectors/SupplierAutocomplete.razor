@* Supplier picker: the shared search box + pop-up (batch 12) with the supplier settings. *@
@using Inventory.Domain.Repository.Abstract
@typeparam T

<LookupAutocomplete TItem="SupplierModel" Settings="Lookups.Supplier"
                    LoadForSearch="LoadForSearch" LoadForDialog="LoadForDialog"
                    SelectedItemChanged="SelectedSupplierChanged" />

@code {
    [Parameter] public EventCallback<SupplierModel> SelectedSupplierChanged { get; set; }
    [Parameter] public SupplierModel SelectedSupplier { get; set; }
    [Inject] private ISupplierRepository SupplierRepository { get; set; } = default!;

    private async Task<List<SupplierModel>> LoadForSearch() =>
        (await SupplierRepository.GetAllForLookup()).Select(s => s.ToModel()).ToList();

    private async Task<List<SupplierModel>> LoadForDialog() =>
        (await SupplierRepository.GetAll()).Select(s => s.ToModel()).ToList();
}
