@* Product picker: the shared search box + pop-up (batch 12) with the product settings. *@
@using Inventory.Domain.Repository.Abstract
@typeparam T

<LookupAutocomplete Class="@Class" EnterPressed="EnterPressed" TItem="ProductModel" Settings="Lookups.Product"
                    LoadForSearch="LoadProducts" LoadForDialog="LoadProducts"
                    Selected="SelectedProduct" SelectedItemChanged="SelectedProductChanged" />

@code {
    /// <summary>Extra CSS class, e.g. to put the cursor in this box when the screen opens.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Enter pressed with a name chosen: the screen moves on (see LookupAutocomplete).</summary>
    [Parameter] public EventCallback<ProductModel> EnterPressed { get; set; }
    [Parameter] public EventCallback<ProductModel> SelectedProductChanged { get; set; }
    [Parameter] public ProductModel SelectedProduct { get; set; }
    [Inject] private IProductRepository ProductRepository { get; set; } = default!;

    private async Task<List<ProductModel>> LoadProducts() =>
        (await ProductRepository.GetAllForLookup()).Select(p => p.ToModel()).ToList();
}
