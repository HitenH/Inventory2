@using Inventory.Domain
@* Stage 2, batch 2-2 (Hiten, 25 Nov 2026): a stock figure shows the sellable pieces only. When there are damaged pieces
   or pieces waiting for approval, a small arrow sits beside the number; clicking the number or the arrow opens the
   breakdown (Sellable / Damaged / Waiting approval) – nothing else is shown until then.
   Waiting pieces have not moved yet, so they are still inside the sellable figure.
   One component for every place stock shows, so they cannot disagree. *@
<span class="stock-fig">
    @if (Figures.HasBreakdown || SplitOverPlaces)
    {
        <button type="button" class="stock-toggle" aria-expanded="@(open ? "true" : "false")"
                title="@($"{HoverText()} – click to {(open ? "hide" : "show")} the breakdown")" @onclick="() => open = !open">
            <span class="stock-sellable @(Figures.Sellable < 0 ? "stock-negative" : "")">@Figures.Sellable</span><span class="stock-caret" aria-hidden="true">@(open ? "▴" : "▾")</span>
        </button>
        @if (open)
        {
            <span class="stock-breakdown">
                <span>Sellable <b>@Figures.Sellable</b></span>
                @* Stage 3, batch 3-3: where the sellable pieces are (only the places this person sees). *@
                @foreach (var place in Places ?? [])
                {
                    <span class="stock-place">in @place.Name <b class="@(place.Qty < 0 ? "stock-negative" : "")">@place.Qty</b></span>
                }
                <span>Damaged <b>@Figures.Damaged</b></span>
                @if (Figures.OnTheWay != 0)
                {
                    @* Stage 3, batch 3-5: sent from one place, not yet received at the other. *@
                    <span class="stock-on-the-way">On the way <b>@Figures.OnTheWay</b></span>
                }
                @if (Figures.Waiting != 0)
                {
                    <span>Waiting approval <b>@Figures.Waiting</b></span>
                }
            </span>
        }
    }
    else
    {
        @* Hiten, 25 Nov 2026: the same width as a figure with an arrow, so every number lines up and the arrows sit one below the other. *@
        <span class="stock-plain"><span class="stock-sellable @(Figures.Sellable < 0 ? "stock-negative" : "")">@Figures.Sellable</span><span class="stock-caret" aria-hidden="true"></span></span>
    }
</span>

@code {
    [Parameter] public StockFigures Figures { get; set; }

    /// <summary>Stage 3, batch 3-3: the sellable pieces per place; with pieces in two or more places the arrow shows them.</summary>
    [Parameter] public IReadOnlyList<PlaceStock>? Places { get; set; }

    private bool SplitOverPlaces => Places is { Count: > 1 };

    private bool open;

    /// <summary>Stage 3: "Shop 4 · Godown 6 · + 3 damaged" – the places (when split) and <see cref="Describe"/>.</summary>
    private string HoverText() => string.Join(" · ",
        (SplitOverPlaces ? Places!.Select(p => $"{p.Name} {p.Qty}") : []).Concat(Describe(Figures) is { Length: > 0 } d ? [d] : Array.Empty<string>()));

    /// <summary>"+ 3 damaged", "+ 3 damaged · 2 waiting" or "2 waiting" (the arrow's hover text).</summary>
    public static string Describe(StockFigures f)
    {
        var parts = new List<string>();
        if (f.Damaged != 0)
        {
            parts.Add($"+ {f.Damaged} damaged");
        }

        if (f.OnTheWay != 0)
        {
            parts.Add($"{f.OnTheWay} on the way");
        }

        if (f.Waiting != 0)
        {
            parts.Add($"{f.Waiting} waiting");
        }

        return string.Join(" · ", parts);
    }
}
