@using Inventory.Authentication
@using Inventory.Service
@implements IDisposable

@inject NavigationManager NavigationManager

<MudNavMenu>
    @if (May(Permissions.ScreenDashboard))
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home"><NavText Text="Dashboard" Url="/" /></MudNavLink>
    }

    <AuthorizeView>
        <Authorized>
            <MudNavLink Icon="@Icons.Material.Filled.AccountCircle" Disabled="true">
                @context.User.Identity?.Name
            </MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Key" Href="/changepassword">Change Password</MudNavLink>
            @if (May(Permissions.ScreenReports))
            {
                <MudNavLink Icon="@Icons.Material.Filled.Report" Href="/reports"><NavText Text="Reports" Url="/reports" /></MudNavLink>
            }
            @if (access.SignedIn && access.Allows(Permissions.ActivitySee))
            {
                @* Batch 1c-5 (Hiten, 25 Nov 2026): a menu item, so someone with the switch but not Settings can reach it. *@
                <MudNavLink Href="/activity" Icon="@Icons.Material.Filled.History">Activity log</MudNavLink>
            }
            @if (May(Permissions.AdminSettings))
            {
                <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings"><NavText Text="Settings" Url="/settings" /></MudNavLink>
            }
            else if (May(Permissions.AdminUsers))
            {
                @* Someone who manages users but not settings still needs a way in (Users and Roles are reached from Settings). *@
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.ManageAccounts">Users and roles</MudNavLink>
            }
            <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logout</MudNavLink>

            @if (May(Permissions.ScreenCustomers) || May(Permissions.ScreenSuppliers) || May(Permissions.ScreenProducts) || May(Permissions.LabelsPrint))
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="px-4 mud-text-secondary">Masters</MudText>
            }
            @if (May(Permissions.ScreenCustomers))
            {
                <MudNavLink Icon="@Icons.Material.Filled.People" Href="/customers"><NavText Text="Customers" Url="/customers" /></MudNavLink>
            }
            @if (May(Permissions.ScreenSuppliers))
            {
                <MudNavLink Icon="@Icons.Material.Filled.Support" Href="/suppliers"><NavText Text="Suppliers" Url="/suppliers" /></MudNavLink>
            }
            @if (May(Permissions.ScreenProducts))
            {
                <MudNavLink Icon="@Icons.Material.Filled.ProductionQuantityLimits" Href="/products"><NavText Text="Products" Url="/products" /></MudNavLink>
            }
            @if (May(Permissions.LabelsPrint))
            {
                @* Stage L (Hiten, 25 Nov 2026): under Masters, after Products; Alt+L. *@
                <MudNavLink Icon="@Icons.Material.Filled.LocalOffer" Href="/labels"><NavText Text="Labels" Url="/labels" /></MudNavLink>
            }

            @if (May(Permissions.ScreenPurchaseOrders) || May(Permissions.ScreenPurchases) || May(Permissions.ScreenSalesOrders) || May(Permissions.ScreenSales) || May(Permissions.ScreenSalesReturns))
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="px-4 mud-text-secondary">Transactions</MudText>
            }
            @if (May(Permissions.ScreenPurchaseOrders))
            {
                <MudNavLink Icon="@Icons.Material.Filled.BorderTop" Href="/purchaseorder"><NavText Text="Purchase Orders" Url="/purchaseorder" /></MudNavLink>
            }
            @if (May(Permissions.ScreenPurchases))
            {
                <MudNavLink Icon="@Icons.Material.Filled.Shop" Href="/purchases"><NavText Text="Purchases" Url="/purchases" /></MudNavLink>
            }
            @if (May(Permissions.ScreenSalesOrders))
            {
                <MudNavLink Icon="@Icons.Material.Filled.Money" Href="/salesorders"><NavText Text="Sale Orders" Url="/salesorders" /></MudNavLink>
            }
            @if (May(Permissions.ScreenSales))
            {
                <MudNavLink Icon="@Icons.Material.Filled.PointOfSale" Href="/sales"><NavText Text="Sales" Url="/sales" /></MudNavLink>
            }
            @if (May(Permissions.ScreenSalesReturns))
            {
                @* Stage 2, batch 2-4: goods customers bring back. No Alt + letter chosen yet. *@
                <MudNavLink Icon="@Icons.Material.Filled.AssignmentReturn" Href="/salesreturns"><NavText Text="Sales Returns" Url="/salesreturns" /></MudNavLink>
            }
        </Authorized>
        <NotAuthorized>
            <MudNavLink Icon="@Icons.Material.Filled.Login" Href="/login">Login</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Inject] private AuthenticationStateProvider authStateProvider { get; set; } = default!;
    [Inject] private AccessService AccessService { get; set; } = default!;

    // Batch 1b-4: the menu shows only what the person's roles allow, read again on every screen change.
    private UserAccess access = UserAccess.Nobody;

    // Before anyone logs in the Dashboard link shows as before (the login page takes over from there).
    private bool May(string permission) => !access.SignedIn || access.Allows(permission);

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        access = await AccessService.CurrentAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        access = await AccessService.CurrentAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    public async Task Logout()
    {
        var customAuthStateProvider = (CustomAuthenticationProvider)authStateProvider;
        await customAuthStateProvider.UpdateAuthenticationState(null);
        NavigationManager.NavigateTo("/", true);
    }
}
